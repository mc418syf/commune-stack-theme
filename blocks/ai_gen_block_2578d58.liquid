      "unit": "px",
      "label": "Bottom spacing",
      "default": 12
    },
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "range",
      "id": "title_margin_left",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Left margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_padding_top",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_padding_bottom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile spacing"
