  {
    "name": "Product text",
    "settings": [
      {
        "type": "paragraph",
        "content": "One set of text sizes for the product page and the product cards in collections, search and recommendations."
      },
      {
        "type": "range",
        "id": "product_info_size",
        "label": "Vendor and title size",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "select",
        "id": "product_name_weight_pdp",
        "label": "Brand and title weight: product page, header",
        "info": "Brand and title use the heading font. The weight is loaded from that font, so it is a real weight, not a faux bold.",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semibold" },
          { "value": "700", "label": "Bold" }
        ],
        "default": "600"
      },
      {
        "type": "select",
        "id": "product_name_weight_card",
        "label": "Brand and title weight: product cards",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semibold" },
          { "value": "700", "label": "Bold" }
        ],
        "default": "400"
      },
      {
        "type": "select",
        "id": "product_info_weight",
        "label": "Buttons and tabs weight",
        "info": "The theme font has only Regular and Bold, so the two in-between looks thicken Regular with a fine outline. They look the same on every device.",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "450", "label": "In between: light" },
          { "value": "500", "label": "In between: medium" },
          { "value": "600", "label": "Semibold (renders as Bold)" },
          { "value": "700", "label": "Bold" }
        ],
        "default": "500"
      },
      {
        "type": "range",
        "id": "product_vendor_title_gap",
        "label": "Space between vendor and title",
        "info": "On the product page and on the product cards.",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "product_title_price_gap",
        "label": "Space between title and price",
        "info": "On the product page and on the product cards.",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "product_card_size_offset",
        "label": "Product cards: size below the product page",
        "info": "Vendor, title and price on the product cards are this much smaller than on the product page.",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "color",
        "id": "gallery_bg",
        "label": "Gallery view: page background",
        "info": "Used only while the PLP gallery view is on; other views keep the colour scheme background.",
        "default": "#dddddd"
      },
      {
        "type": "range",
        "id": "recommendation_card_size_offset",
        "label": "Recommended products: extra size reduction",
        "info": "Cards under \"You may also like\" are this much smaller than the collection page cards, on top of the card offset above.",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "select",
        "id": "product_info_letterspacing",
        "label": "Letter spacing",
        "info": "Applies to the vendor, title and price together so they match.",
        "options": [
          { "value": "-0.04em", "label": "Tighter" },
          { "value": "-0.025em", "label": "Tight (like the headings)" },
          { "value": "0em", "label": "Normal" },
          { "value": "0.03em", "label": "Wide" }
