      {
        "type": "header",
        "content": "Grid"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#000000"
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "accent_contrast",
            "label": "Accent contrast",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary",
            "label": "Secondary",
            "default": "#121212"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "accent",
          "on_primary_button": "accent_contrast",
          "primary_button_border": "accent",
          "secondary_button": "text",
          "on_secondary_button": "background",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "text"
        }
      },
      {
        "type": "header",
        "content": "Modals"
      },
      {
        "type": "color_scheme",
        "id": "modal_color_scheme",
        "label": "Modal color scheme",
        "info": "Used for cart drawer, popups, and other modals",
        "default": "scheme2"
      },
      {
        "type": "header",
        "content": "Selected text"
      },
      {
        "type": "radio",
        "id": "selected_text_background_color",
        "label": "Selected text background color",
        "options": [
          {
            "value": "text",
            "label": "Text"
          },
          {
            "value": "accent",
            "label": "Accent"
          }
        ],
        "default": "accent"
      }
    ]
  },
