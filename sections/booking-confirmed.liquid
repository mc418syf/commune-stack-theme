<div
  class="color-scheme"
  data-color-scheme="{{ section.settings.color_scheme | default: 'default' }}"
  x-data
  x-init="$store.tryOnList && $store.tryOnList.clear()"
  style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:80px 24px; text-align:center;"
>
  <div style="max-width:480px;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin:0 auto 24px; opacity:0.7;">
      <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M12 4a2 2 0 1 1 0 4m0-4a2 2 0 1 0 0 4m0-4v4m0 0L3 18h18L12 8Z"/>
    </svg>
    <p style="font-size:11px; letter-spacing:0.16em; text-transform:uppercase; opacity:0.5; margin-bottom:12px;">
      {{ section.settings.eyebrow | default: 'Appointment Confirmed' }}
    </p>
    <h1 style="font-size:22px; font-weight:500; line-height:1.3; margin-bottom:16px;">
      {{ section.settings.heading | default: "We'll see you at the showroom." }}
    </h1>
    <p style="font-size:14px; line-height:1.7; opacity:0.65; margin-bottom:32px;">
      {{ section.settings.body | default: "Your fitting appointment is booked. We'll have your selected pieces ready at the showroom." }}
    </p>
    <a
      href="{{ section.settings.cta_url | default: '/' }}"
      class="theme-button"
      style="display:inline-flex; align-items:center; gap:8px; padding:12px 28px; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none;"
    >
      {{ section.settings.cta_label | default: 'Continue Shopping' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Booking Confirmed",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Appointment Confirmed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We'll see you at the showroom."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Your fitting appointment is booked. We'll have your selected pieces ready at the showroom."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Booking Confirmed"
    }
  ]
}
{% endschema %}
