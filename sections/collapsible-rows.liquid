{%- comment -%} Layout "columns": title left, details right on desktop; stacked on mobile. {%- endcomment -%}
{%- liquid
  assign section_color = section.settings.color_scheme
  assign heading_font = section.settings.heading_font
  assign heading_font_size = section.settings.heading_font_size
-%}

<section
  class="overflow-hidden border-b-gridline border-gridline-color bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section_color }}"
>
  {% if section.settings.title != '' %}
    {%- render 'section-title',
      title: section.settings.title,
      section_color: section_color
    -%}
  {% endif %}

  {%- if section.settings.layout == 'columns' -%}
    <div class="info-rows px-section-horizontal-spacing">
      {%- for block in section.blocks -%}
        <article class="info-row" {{ block.shopify_attributes }}>
          <h2 class="info-row__title">{{ block.settings.title }}</h2>
          <div class="info-row__body rte">{{ block.settings.expanded_content }}</div>
        </article>
      {%- endfor -%}
    </div>
    <style>
      .info-rows { padding-top: 8px; padding-bottom: 24px; }
      .info-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px 0; border-top: 1px dashed var(--rule-dashed); }
      .info-row:first-child { border-top: 0; }
      .info-row__title { margin: 0; font-family: var(--font-display); font-weight: var(--head-weight, 600); font-size: var(--head-size); line-height: var(--head-lh); letter-spacing: var(--head-ls); text-transform: uppercase; }
      .info-row__body { min-width: 0; }
      .info-row__body > :first-child { margin-top: 0; }
      @media (min-width: 768px) {
        .info-row { grid-template-columns: minmax(180px, 1fr) minmax(0, 2fr); column-gap: 48px; padding: 28px 0; }
      }
    </style>
  {%- else -%}
  <ul>
    {% for block in section.blocks %}
      <li {{ block.shopify_attributes }}>
        {%- render 'collapsible',
          title: block.settings.title,
          id: block.id,
          expanded_content: block.settings.expanded_content,
          heading_font: heading_font,
          heading_font_size: heading_font_size,
          expanded_content_max_width: section.settings.expanded_content_max_width,
          last_in_loop: forloop.last
        -%}
      </li>
    {% endfor %}
  </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collapsible rows",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collapsible rows"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "accordion",
          "label": "Accordion (tap a title to open it)"
        },
        {
          "value": "columns",
          "label": "Columns: title left, details right; stacked on mobile"
        }
      ],
      "default": "columns"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "font-heading",
          "label": "Heading"
        },
        {
          "value": "font-main",
          "label": "Body"
        }
      ],
      "default": "font-heading"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading font size",
      "options": [
        {
          "value": "text-heading-standard",
          "label": "Standard"
        },
        {
          "value": "text-heading-feature",
          "label": "Feature"
        },
        {
          "value": "text-heading-secondary",
          "label": "Secondary"
        }
      ],
      "default": "text-heading-standard",
      "info": "Applies when heading font is set to “Heading”"
    },
    {
      "type": "select",
      "id": "expanded_content_max_width",
      "label": "Max width of expanded content",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "max-w-sm",
          "label": "Small"
        },
        {
          "value": "max-w-lg",
          "label": "Medium"
        },
        {
          "value": "max-w-xl",
          "label": "Large"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "name": "Row",
      "type": "row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "expanded_content",
          "label": "Expanded content",
          "default": "<p>Use this text to share information about your brand with your customers.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible rows",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
