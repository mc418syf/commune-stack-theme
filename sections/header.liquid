{%- liquid
  assign section_color = section.settings.color_scheme
  assign item_spacing = 'py-2'
-%}

{%- capture header_logo -%}
  <a
    href="{{ routes.root_url }}"
    class="header-logo-mobile-centered break-word my-auto inline-block {{ item_spacing }}"
  >
    {% if template.name == 'index' %}
      <h1 class="contents">
    {% endif %}
    {% if settings.logo != blank %}
      <div class="max-w-[var(--logo-max-width)]">
        {% liquid
          assign logo = settings.logo

          assign logo_max_width_mobile = section.settings.logo_max_width_mobile
          assign logo_max_width_mobile_2x = section.settings.logo_max_width_mobile | times: 2
          assign logo_max_width_mobile_3x = section.settings.logo_max_width_mobile | times: 3

          assign logo_max_width = section.settings.logo_max_width
          assign logo_max_width_2x = section.settings.logo_max_width | times: 2
          assign logo_max_width_3x = section.settings.logo_max_width | times: 3
        %}
        {% comment %}DISABLED scroll logo swap: main logo always renders{% endcomment %}
          <img
            src="{{ logo | image_url: width: logo_max_width }}"
            srcset="
              {%- if logo_max_width != logo_max_width_mobile -%}
                {{- logo | image_url: width: logo_max_width_mobile }} {{ logo_max_width_mobile }}w,
                {{- logo | image_url: width: logo_max_width_mobile_2x }} {{ logo_max_width_mobile_2x }}w,
                {{- logo | image_url: width: logo_max_width_mobile_3x }} {{ logo_max_width_mobile_3x }}w,
              {%- endif -%}
              {{- logo | image_url: width: logo_max_width }} {{ logo_max_width }}w,
              {{- logo | image_url: width: logo_max_width_2x }} {{ logo_max_width_2x }}w,
              {{- logo | image_url: width: logo_max_width_3x }} {{ logo_max_width_3x }}w
            "
            width="{{ logo.width }}"
            height="{{ logo.height }}"
            loading="eager"
            {% if logo_max_width != logo_max_width_mobile %}
              sizes="(min-width: 1024px) {{ logo_max_width }}px, {{ logo_max_width_mobile }}px"
            {% else %}
              sizes="{{ logo_max_width_mobile }}px"
            {% endif %}
            alt="{{ logo.alt | default: shop.name }}"
          >
        {% comment %}DISABLED: overlay logo swap block removed{% endcomment %}
      </div>
    {% else %}
      {{ shop.name }}
    {% endif %}
    {% if template.name == 'index' %}
      </h1>
    {% endif %}
  </a>
{%- endcapture -%}

{%- liquid
  assign vellum_alpha = section.settings.vellum_opacity | default: 72 | divided_by: 100.0
  assign vellum_rgb = section.settings.vellum_color | default: '#F4F3EF' | color_to_rgb | remove: 'rgb(' | remove: ')'
-%}
{% style %}
  .edge-rail, .edge-panel, .edge-search, .edge-strip {
    --paper: {{ section.settings.vellum_color | default: '#F4F3EF' }};
    --ink: {{ section.settings.ink_color | default: '#111111' }};
    --gray: {{ section.settings.muted_color | default: '#6B6B66' }};
    --orange: {{ section.settings.accent_color | default: '#FF5A1F' }};
    --orange-ink: {{ section.settings.accent_text_color | default: '#C23B05' }};
  }
  {% if section.settings.vellum_stack != false %}
  .edge-strip {
    --vellum-layer: linear-gradient(rgba({{ vellum_rgb }}, {{ vellum_alpha }}), rgba({{ vellum_rgb }}, {{ vellum_alpha }})), rgb(var(--color-scheme-background));
  }
  {% endif %}
  {% if section.settings.vellum_match_page != false %}
  .edge-strip {
    --paper: rgb(var(--color-scheme-background));
    --vellum: rgb(var(--color-scheme-background) / {{ vellum_alpha }});
  }
  {% endif %}
  :root {
    --vellum: rgba({{ vellum_rgb }}, {{ vellum_alpha }});
    --vellum-blur: {{ section.settings.vellum_blur | default: 18 }}px;
    --tab-w: {{ section.settings.tab_width | default: 30 }}px;
    --strip-h: {{ section.settings.strip_height | default: 56 }}px;
  }
  @media (min-width: 768px) {
    :root {
      --panel-w: {{ section.settings.panel_width | default: 380 }}px;
    }
  }
{% endstyle %}

<header-section
  class="block"
  data-color-scheme="{{ section_color }}"
  id="{{ section.id }}"
  data-theme-header
>
  <header class="edge-strip text-scheme-text" data-logo="{{ section.settings.logo_align | default: 'left' }}" data-color-scheme="{{ section_color }}" data-sticky="{{ section.settings.strip_sticky | default: true }}">
    {% render 'edge-rail', header_logo: header_logo, section: section %}
  </header>
</header-section>

{% schema %}
{
  "name": "Header",
  "class": "section-header relative z-20",
  "settings": [
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 20,
      "max": 350,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 250
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "min": 20,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Mobile logo width",
      "default": 80
    },
    {
      "type": "link_list",
      "id": "edge_menu",
      "label": "Rail menu",
      "info": "Menu tab links. Uses the four default rows when no menu is chosen."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Fallback menu",
      "default": "main-menu",
      "info": "This menu is only displayed on desktop. To change navigation for mobile/drawer menu, go to sidebar settings."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "checkbox",
      "id": "vellum_stack",
      "label": "Stack vellum on the page background",
      "default": true,
      "info": "Paints the page background colour first, then lays the vellum colour and opacity on top, so the rail and panel never show the page through. Turn off for a see-through, blurred look."
    },
    {
      "type": "checkbox",
      "id": "vellum_match_page",
      "label": "Match the page background",
      "default": true,
      "info": "Colours the rail and panel from the page's colour scheme (Theme settings > Colors). Turn off to pick a vellum colour below."
    },
    {
      "type": "color",
      "id": "vellum_color",
      "label": "Vellum colour",
      "default": "#F4F3EF",
      "info": "Colour of the rail, panel and search window."
    },
    {
      "type": "range",
      "id": "vellum_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vellum opacity",
      "default": 72,
      "info": "Lower is more see-through."
    },
    {
      "type": "range",
      "id": "vellum_blur",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vellum blur",
      "default": 18
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Text colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text colour",
      "default": "#6B6B66"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent fill (buttons, cart dot)",
      "default": "#FF5A1F"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text and hover",
      "default": "#C23B05"
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "range",
      "id": "tab_width",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Tab width",
      "default": 30,
      "info": "The width of the folder tabs on the left edge."
    },
    {
      "type": "range",
      "id": "panel_width",
      "min": 280,
      "max": 560,
      "step": 10,
      "unit": "px",
      "label": "Panel and search width, desktop",
      "default": 380,
      "info": "On mobile the panel fills the screen beside the rail."
    },
    {
      "type": "range",
      "id": "strip_height",
      "min": 40,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Logo strip height",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "strip_sticky",
      "label": "Sticky logo strip",
      "default": true,
      "info": "Transparent strip that stays at the top while scrolling."
    },
    {
      "type": "select",
      "id": "logo_align",
      "label": "Logo position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Components"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Cart tab (cart and try-on together)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Search tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock_switch",
      "label": "Hide sold out switch (collections)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "tab_menu",
      "label": "Menu tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "tab_filter",
      "label": "Filter tab (collection pages)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "tab_cart",
      "label": "Cart window opens from the Cart tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_expand",
      "label": "Open the panel when hovering the rail (desktop)",
      "default": true,
      "info": "Hover opens and closes the panel; clicking pins it open."
    },
    {
      "type": "header",
      "content": "Menu tab"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer links",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "menu_footer_links",
      "label": "Footer links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "menu_newsletter",
      "label": "Newsletter sign-up",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "menu_social",
      "label": "Social links (from Theme settings > Social)",
      "default": true
    }
  ]
}
{% endschema %}
