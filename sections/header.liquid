{%- liquid
  assign layout = section.settings.layout
  assign section_color = section.settings.color_scheme
  assign overlay_text_color_scheme = section.settings.overlay_text_color_scheme
  assign show_icons = section.settings.show_icons

  if section.settings.overlay_homepage and template.name == 'index'
    assign overlay_header = true

    if section.settings.sticky_header
      assign overlay_header_with_sticky = true
    else
      assign overlay_header_without_sticky = true
    endif
  endif

  assign drop_down_flex_alignment = 'justify-center'

  if section.settings.layout contains 'menu_left'
    assign drop_down_flex_alignment = 'justify-start'
  endif

  assign locale_selector = false
  assign country_selector = false

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign country_selector = true
  endif

  if section.settings.show_locale_selector and shop.published_locales.size > 1
    assign locale_selector = true
  endif

  if locale_selector or country_selector
    assign show_localization = true
  endif

  assign item_spacing = section.settings.header_vertical_spacing
  assign show_try_on_button = section.settings.show_try_on_button
  assign mobile_layout = section.settings.mobile_layout
-%}

{%- capture header_logo -%}
  <a
    href="{{ routes.root_url }}"
    class="header-logo-mobile-centered break-word my-auto inline-block {{ item_spacing }}"
  >
    {% if template.name == 'index' %}
      <h1 class="contents">
    {% endif %}
    {% if settings.logo != blank %}
      <div class="max-w-[var(--logo-max-width)]">
        {% liquid
          assign logo = settings.logo

          assign logo_max_width_mobile = section.settings.logo_max_width_mobile
          assign logo_max_width_mobile_2x = section.settings.logo_max_width_mobile | times: 2
          assign logo_max_width_mobile_3x = section.settings.logo_max_width_mobile | times: 3

          assign logo_max_width = section.settings.logo_max_width
          assign logo_max_width_2x = section.settings.logo_max_width | times: 2
          assign logo_max_width_3x = section.settings.logo_max_width | times: 3
        %}
        {%- unless overlay_header_without_sticky
          and section.settings.overlay_logo != blank
        -%}
          <img
            src="{{ logo | image_url: width: logo_max_width }}"
            srcset="
              {%- if logo_max_width != logo_max_width_mobile -%}
                {{- logo | image_url: width: logo_max_width_mobile }} {{ logo_max_width_mobile }}w,
                {{- logo | image_url: width: logo_max_width_mobile_2x }} {{ logo_max_width_mobile_2x }}w,
                {{- logo | image_url: width: logo_max_width_mobile_3x }} {{ logo_max_width_mobile_3x }}w,
              {%- endif -%}
              {{- logo | image_url: width: logo_max_width }} {{ logo_max_width }}w,
              {{- logo | image_url: width: logo_max_width_2x }} {{ logo_max_width_2x }}w,
              {{- logo | image_url: width: logo_max_width_3x }} {{ logo_max_width_3x }}w
            "
            width="{{ logo.width }}"
            height="{{ logo.height }}"
            loading="eager"
            {% if logo_max_width != logo_max_width_mobile %}
              sizes="(min-width: 1024px) {{ logo_max_width }}px, {{ logo_max_width_mobile }}px"
            {% else %}
              sizes="{{ logo_max_width_mobile }}px"
            {% endif %}
            alt="{{ logo.alt | default: shop.name }}"
            {% if overlay_header_with_sticky
              and section.settings.overlay_logo != blank
            %}
              x-show="isStuck"
            {% endif %}
          >
        {% endunless %}

        {% if overlay_header and section.settings.overlay_logo != blank %}
          {% assign overlay_logo = section.settings.overlay_logo %}
          <img
            src="{{ overlay_logo | image_url: width: logo_max_width }}"
            srcset="
              {%- if logo_max_width != logo_max_width_mobile -%}
                {{- overlay_logo | image_url: width: logo_max_width_mobile }} {{ logo_max_width_mobile }}w,
                {{- overlay_logo | image_url: width: logo_max_width_mobile_2x }} {{ logo_max_width_mobile_2x }}w,
                {{- overlay_logo | image_url: width: logo_max_width_mobile_3x }} {{ logo_max_width_mobile_3x }}w,
              {%- endif -%}
              {{- overlay_logo | image_url: width: logo_max_width }} {{ logo_max_width }}w,
              {{- overlay_logo | image_url: width: logo_max_width_2x }} {{ logo_max_width_2x }}w,
              {{- overlay_logo | image_url: width: logo_max_width_3x }} {{ logo_max_width_3x }}w
            "
            width="{{ overlay_logo.width }}"
            height="{{ overlay_logo.height }}"
            loading="eager"
            {% if logo_max_width != logo_max_width_mobile %}
              sizes="(min-width: 1024px) {{ logo_max_width }}px, {{ logo_max_width_mobile }}px"
            {% else %}
              sizes="{{ logo_max_width_mobile }}px"
            {% endif %}
            {% if overlay_header_with_sticky %}
              x-show="!isStuck"
            {% endif %}
          >
        {% endif %}
      </div>
    {% else %}
      {{ shop.name }}
    {% endif %}
    {% if template.name == 'index' %}
      </h1>
    {% endif %}
  </a>
{%- endcapture -%}

{%- liquid
  capture header_menu
    render 'header-menu', layout: layout, drop_down_flex_alignment: drop_down_flex_alignment, item_spacing: item_spacing
  endcapture
-%}

{%- capture header_menu_toggle -%}
  <button
    class="inline-block no-js:hidden lg:hidden {{ item_spacing }}{% if settings.header_uppercase %} uppercase{% endif %}"
    :aria-expanded="$store.modals.leftDrawer.contents === 'sidebar'"
    @click="$store.modals.leftDrawer.open ? $store.modals.close('sidebar') : $store.modals.open('sidebar')"
  >
    {%- if show_icons -%}
      <span class="sr-only">{{ 'layout.navigation.menu' | t }}</span>
      <span
        class="header-menu-toggle-icon inline-block h-6 w-6 align-middle"
        style="transition: transform 0.3s ease;"
        :style="{ transform: ($store.modals.leftDrawer.open && $store.modals.leftDrawer.contents === 'sidebar') ? 'rotate(45deg)' : 'rotate(0deg)' }"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="3" y1="15" x2="21" y2="15"/>
        </svg>
      </span>
    {%- else -%}
      {{ 'layout.navigation.menu' | t }}
    {%- endif -%}
  </button>
{%- endcapture -%}

{%- capture header_cart %}
  <a
    href="{{ routes.cart_url }}"
    class="inline-flex items-center {{ item_spacing }}"
    aria-label="{{ 'layout.cart.title' | t }}"
    {% if settings.cart_type == 'drawer' and template != 'cart' %}
      data-cart-drawer-toggle
      :aria-expanded="$store.modals.rightDrawer.contents === 'cart'"
      @click.prevent="$store.modals.open('cart')"
      @keydown.space="$store.modals.open('cart')"
    {% endif %}
  >
    <span
      class="inline-flex items-center justify-center text-sm leading-none"
      style="background: #D8D4CD; color: rgb(var(--color-scheme-text)); min-width: 1.5rem; height: 1.5rem; padding: 0 0.4rem;"
      x-text="$store.cartCount.count > 0 ? $store.cartCount.count : ''"
    >{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
    <span class="sr-only">{{ 'layout.cart.title' | t }}</span>
  </a>
{%- endcapture -%}

{%- liquid
  if show_localization
    capture localization_form
      assign button_class = 'text-base ' | append: item_spacing
      render 'localization-form', context: 'header', wrapper_classes: 'justify-end max-lg:hidden', open: 'top-full left-0 right-auto', locale_selector: locale_selector, country_selector: country_selector, button_classes: button_class, options_max_width: 'max-w-[theme(spacing.64)]', option_text_size: 'text-base', option_padding: 'px-4 py-2'
    endcapture
  endif
-%}

{% if overlay_header %}
  {% style %}
    #{{ section.id }} {
      --color-gridline: {{ section.settings.overlay_text_color_scheme.settings.text.rgb }};
    }

    {% if overlay_header_with_sticky %}
      #{{ section.id }}.is-stuck {
        --color-gridline: {{ section.settings.color_scheme.settings.text.rgb }};
      }
    {% endif %}
    {% style %}
{% endstyle %}
  {% endstyle %}
{% endif %}

<header-section
  x-data="Theme_Header"
  class="block{% if overlay_header %} absolute top-0 left-0 right-0 z-50{% endif %}"
  :class="{ 'is-stuck' : isStuck, 'invisible pointer-events-none' : $store.modals && $store.modals.modal && $store.modals.modal.open }"
  {% if section.settings.sticky_header %}
    data-sticky="true"
  {% endif %}
  {% if overlay_header %}
    data-overlay-header="true"
  {% endif %}
  data-color-scheme="{{ section_color }}"
  data-overlay-header-with-sticky="{{ overlay_header_with_sticky | default: false }}"
  data-overlay-text-color-scheme="{{ overlay_text_color_scheme }}"
  id="{{ section.id }}"
  data-theme-header
>
  <header
    x-ref="header"
    :class="$store.modals.leftDrawer.open ? 'drawer-open-header' : ''"
    class="relative z-10 border-b-gridline border-gridline-color text-scheme-text {% unless overlay_header %} border-gridline-color bg-scheme-background{% endunless %}"
    data-color-scheme="{%- if overlay_header_without_sticky -%}{{ overlay_text_color_scheme }}{%- else -%}{{ section_color }}{%- endif -%}"
  >
    <nav
      class="relative hidden{% if settings.header_uppercase %} uppercase{% endif %}{% unless layout contains 'menu_drawer' %} lg:block{% endunless %}"
      aria-label="{{ 'general.accessibility.primary' | t }}"
    >
      {%- comment -%} Single flat flex row: logo | menu (flex-1) | actions — all items-center {%- endcomment -%}
      <div class="px-section-horizontal-spacing" style="display:flex; align-items:stretch; justify-content:space-between;">

        {%- comment -%} LEFT — logo (+ menu if left layout) {%- endcomment -%}
        <div style="display:flex; flex-shrink:0; align-items:center;">
          {% if layout contains 'logo_left' %}
            {{ header_logo }}
          {% endif %}
          {% if layout contains 'menu_left' %}
            <div style="margin-left:1.5rem;">{{ header_menu }}</div>
          {% endif %}
        </div>

        {%- comment -%} CENTER — menu / logo-center {%- endcomment -%}
        {% if layout contains 'menu_spread' or layout contains 'menu_center' %}
          <div style="display:flex; flex:1 1 0%; align-items:center; justify-content:center;">
            {% if layout contains 'logo_center' %}{{ header_logo }}{% endif %}
            {{ header_menu }}
          </div>
        {% elsif layout contains 'menu_right' %}
          <div style="display:flex; flex:1 1 0%; align-items:center; justify-content:flex-end;">
            {{ header_menu }}
          </div>
        {% elsif layout contains 'logo_center' %}
          <div style="display:flex; flex:1 1 0%; align-items:center; justify-content:center;">
            {{ header_logo }}
          </div>
        {% else %}
          <div style="flex:1 1 0%;"></div>
        {% endif %}

        {%- comment -%} RIGHT — localization · accounts · search · try-on · cart {%- endcomment -%}
        <div style="display:flex; flex-shrink:0; align-items:center; column-gap:1rem;">
          {%- if show_localization -%}
            {{ localization_form }}
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            {{ customer_accounts }}
          {%- endif -%}

          {% if section.settings.show_search %}
            {% render 'header-search',
              layout: layout,
              header_item_spacing: item_spacing,
              section_color: section_color,
              show_icons: show_icons
            %}
          {% endif %}

          {% if show_try_on_button %}
            <div x-data>
              <a
                href="/pages/try-in-store"
                class="inline-flex items-center {{ item_spacing }}"
                aria-label="Try In-Store"
              >
                <span
                  class="inline-flex items-center justify-center text-sm leading-none"
                  style="background: rgb(var(--color-scheme-accent)); color: rgb(var(--color-scheme-background)); min-width: 1.5rem; height: 1.5rem; padding: 0 0.4rem;"
                  x-text="$store.tryOnList.count > 0 ? $store.tryOnList.count : ''"
                ></span><script>(function(){try{var n=(JSON.parse(localStorage.getItem('commune_try_on_list')||'[]')||[]).length;document.currentScript.previousElementSibling.textContent=n>0?n:'';}catch(e){}})();</script>
                <span class="sr-only">Try In-Store</span>
              </a>
            </div>
          {% endif %}

          {{ header_cart }}
        </div>

      </div>

      {% if layout contains 'menu_below' %}
        <div class="border-t-gridline border-gridline-color px-section-horizontal-spacing" style="display:flex; align-items:center; justify-content:center;">
          {{ header_menu }}
        </div>
      {% endif %}
    </nav>

    {% comment %}
      Mobile Nav
    {% endcomment %}
    <nav
      aria-label="{{ 'general.accessibility.header' | t }}"
      class="{% unless layout contains 'menu_drawer' %}lg:hidden{% endunless %}{% if settings.header_uppercase %} uppercase{% endif %}"
    >
      <div class="flex items-center justify-between px-section-horizontal-spacing lg:relative">
        <div class="flex gap-2 items-center{% if mobile_layout == 'logo_center' %} flex-grow w-1/3{% endif %}">
          {% if mobile_layout == 'logo_left' %}
            <div>
              {{ header_logo }}
            </div>
          {% elsif mobile_layout == 'logo_center' %}
            {{ header_menu_toggle }}
          {% endif %}
        </div>

        {% if mobile_layout == 'logo_center' %}
          <div class="shrink-0 justify-center text-center">
            {{ header_logo }}
          </div>
        {% endif %}

        <div class="flex justify-end gap-2 items-center text-right{% if mobile_layout == 'logo_center' %} flex-grow flex-wrap w-1/3{% endif %}">
          {% if mobile_layout == 'logo_left' %}
            {{ header_menu_toggle }}
          {% endif %}

          {% if layout contains 'menu_drawer' %}
            {%- if show_localization -%}
              <div class="my-auto hidden shrink-0 lg:block">
                {{ localization_form }}
              </div>
            {%- endif -%}

            {%- if shop.customer_accounts_enabled -%}
              <div class="hidden whitespace-nowrap lg:block">
                {{ customer_accounts }}
              </div>
            {%- endif -%}
          {% endif %}

          {% if section.settings.show_search %}
            <div class="whitespace-nowrap lg:ml-4">
              {% render 'header-search',
                layout: layout,
                header_item_spacing: item_spacing,
                section_color: section_color,
                show_icons: show_icons,
                location: 'mobile'
              %}
            </div>
          {% endif %}
          {% comment %} Try In-Store button — mobile {% endcomment %}
          {% if show_try_on_button %}
          <div class="whitespace-nowrap lg:ml-4" x-data>
            <a
              href="/pages/try-in-store"
              class="inline-flex items-center {{ item_spacing }}"
              aria-label="Try In-Store"
            >
              <span
                class="inline-flex items-center justify-center text-sm leading-none"
                style="background: rgb(var(--color-scheme-accent)); color: rgb(var(--color-scheme-background)); min-width: 1.5rem; height: 1.5rem; padding: 0 0.4rem;"
                x-text="$store.tryOnList.count > 0 ? $store.tryOnList.count : ''"
              ></span><script>(function(){try{var n=(JSON.parse(localStorage.getItem('commune_try_on_list')||'[]')||[]).length;document.currentScript.previousElementSibling.textContent=n>0?n:'';}catch(e){}})();</script>
              <span class="sr-only">Try In-Store</span>
            </a>
          </div>
          {% endif %}

          <div class="whitespace-nowrap lg:ml-4">
            {{ header_cart }}
          </div>
        </div>
      </div>
    </nav>
  </header>
</header-section>

{%- liquid
  if settings.enable_breadcrumbs
    render 'breadcrumbs', section_color: 'header'
  endif
-%}

<noscript>
  {% style %}
    .no-js-focus-wrapper:focus-within .no-js-focus-container {
      display: block !important;
    }

    {% if layout == 'logo_center_menu_drawer' %}
      .section-sidebar {
        display: block !important;
      }
    {%- endif -%}
  {% endstyle %}
</noscript>

{% style %}
  /* === Sticky header === */
  {% if section.settings.sticky_header %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 30;
    }
    :root {
      --sticky-header-height: 66px;
    }
  {% else %}
    :root {
      --sticky-header-height: 0;
    }
  {% endif %}

  /* === Force sticky on mobile === */
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 100;
    }
    #shopify-section-{{ section.id }} nav {
      position: relative;
    }
  }

  /* === Logo width === */
  #shopify-section-{{ section.id }} {
    --logo-max-width: {{ section.settings.logo_max_width_mobile }}px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} {
      --logo-max-width: {{ section.settings.logo_max_width }}px;
    }
  }

  /* === Mobile centered logo (only for the logo-center mobile layout) === */
  {% if section.settings.mobile_layout == 'logo_center' %}
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} a.header-logo-mobile-centered {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 40;
      pointer-events: auto;
    }
    #shopify-section-{{ section.id }} a.header-logo-mobile-centered .max-w-\[var\(--logo-max-width\)\] {
      max-width: calc(var(--logo-max-width) * 0.9);
    }
  }
  {% endif %}

  /* === Frosted glass header === */
  #shopify-section-{{ section.id }} header {
    position: relative;
    background: rgb(var(--color-scheme-background) / 0.2) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border-bottom: none !important;
  }

  /* === Remove gridlines === */
  #shopify-section-{{ section.id }} .border-b-gridline {
    border-bottom: none !important;
    border-bottom-width: 0 !important;
  }

  /* === Frosted glass dropdown === */
  #shopify-section-{{ section.id }} .submenu {
    background: rgb(var(--color-scheme-background) / 0.4) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: none !important;
  }
  #shopify-section-{{ section.id }} .submenu li,
  #shopify-section-{{ section.id }} .submenu a {
    border: none !important;
  }

/* === Frosted glass search bar === */
  #shopify-section-{{ section.id }} [x-ref="searchComponent"] {
    background: rgb(var(--color-scheme-background) / 0.4) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: none !important;
    top: 0 !important;
    padding-top: calc(var(--sticky-header-height, 56px) + 0.5rem) !important;
  }
  /* === Frosted glass search results === */
#shopify-section-{{ section.id }} [x-ref="searchComponent"] {
  background: rgb(var(--color-scheme-background) / 0.4) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: none !important;
}

/* === Frosted glass predictive results === */
#shopify-section-{{ section.id }} .predictive-search-results > div {
  background: rgb(var(--color-scheme-background) / 0.4) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: none !important;
}

/* === Remove result divider lines === */
#shopify-section-{{ section.id }} .predictive-search-results li,
#shopify-section-{{ section.id }} .predictive-search-results a {
  border-bottom: none !important;
  border-top: none !important;
}

/* === 2 products per row in search results === */
#shopify-section-{{ section.id }} .predictive-search-results ul.grid {
  grid-template-columns: repeat(2, 1fr) !important;
}
/* === Remove search input border === */
#shopify-section-{{ section.id }} input[type="search"] {
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
}
/* === Menu icon rotation === */
.header-menu-toggle-icon {
  transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
}
.drawer-open .header-menu-toggle-icon {
  transform: rotate(90deg);
}
{% endstyle %}
<script
  type="module"
>
  if (!customElements.get('header-section')) {
    class HeaderSection extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        if (this.getAttribute('data-sticky')) {
          document.documentElement.style.setProperty(
            '--sticky-header-height',
            `${this.getBoundingClientRect().height}px`
          );
        } else {
          document.documentElement.style.setProperty(
            '--sticky-header-height',
            '0'
          );
        }
      }
    }

    customElements.define('header-section', HeaderSection);
  }
</script>

{% unless request.design_mode %}
  <script src="{{ 'cart-count.js' | asset_url }}" type="module"></script>
  <script src="{{ 'header.js' | asset_url }}" type="module"></script>

  {% if settings.predictive_search_enabled %}
    <script
      src="{{ 'predictive-search.js' | asset_url }}"
      type="module"
    ></script>
  {% endif %}
  <script>
  document.addEventListener('alpine:init', () => {
    Alpine.effect(() => {
      if (Alpine.store('modals').leftDrawer.open) {
        document.body.classList.add('drawer-open');
      } else {
        document.body.classList.remove('drawer-open');
      }
    });
  });
</script>
{% endunless %}

{% schema %}
{
  "name": "Header",
  "class": "section-header relative z-20",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "paragraph",
      "content": "Edit your logo in [theme settings](/editor?context=theme&category=logo)."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 20,
      "max": 350,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 250
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "min": 20,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Mobile logo width",
      "default": 80
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "This menu is only displayed on desktop. To change navigation for mobile/drawer menu, go to sidebar settings."
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "logo_left_menu_left",
          "label": "Logo left / menu left"
        },
        {
          "value": "logo_left_menu_right",
          "label": "Logo left / menu right"
        },
        {
          "value": "logo_left_menu_center",
          "label": "Logo left / menu center"
        },
        {
          "value": "logo_left_menu_spread",
          "label": "Logo left / menu spread"
        },
        {
          "value": "logo_left_menu_below",
          "label": "Logo left / menu below"
        },
        {
          "value": "logo_center_menu_left",
          "label": "Logo center / menu left"
        },
        {
          "value": "logo_center_menu_drawer",
          "label": "Logo center / menu drawer"
        }
      ],
      "label": "Desktop layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "logo_left",
          "label": "Logo left"
        },
        {
          "value": "logo_center",
          "label": "Logo centered"
        }
      ],
      "default": "logo_left"
