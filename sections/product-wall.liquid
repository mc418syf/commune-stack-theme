{%- liquid
  assign section_color = section.settings.color_scheme
  assign collection_handle = section.settings.collection.handle | default: 'all'

  comment
    Rows on screen drive the image height, so reserve room for the text under each image.
  endcomment
  assign meta_lines = 0
  if section.settings.show_vendor or section.settings.show_price
    assign meta_lines = meta_lines | plus: 1
  endif
  if section.settings.show_title
    assign meta_lines = meta_lines | plus: 1
  endif
  assign meta_height = 0
  if meta_lines > 0
    assign meta_height = meta_lines | times: 13 | plus: 6
  endif
-%}

<section
  class="product-wall bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section_color }}"
  data-product-wall
  data-collection="{{ collection_handle }}"
  data-speed="{{ section.settings.speed | divided_by: 100.0 }}"
  data-per-row="{{ section.settings.products_per_row }}"
  data-hide-sold-out="{{ section.settings.hide_sold_out }}"
  data-show-vendor="{{ section.settings.show_vendor }}"
  data-show-title="{{ section.settings.show_title }}"
  data-show-price="{{ section.settings.show_price }}"
  data-currency="{{ shop.currency }}"
  data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
  style="--wall-rows-desktop: {{ section.settings.rows_desktop }}; --wall-rows-mobile: {{ section.settings.rows_mobile }}; --wall-meta-h: {{ meta_height }}px;"
>
  <div class="product-wall__rows" data-product-wall-rows aria-label="{{ section.settings.collection.title | default: 'All products' | escape }}"></div>
  <noscript>
    <p class="product-wall__empty"><a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'collections.general.view_all' | t }}</a></p>
  </noscript>
</section>

{{ 'product-wall.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-wall.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product wall",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Every product in rotating rows. Rows autoplay in alternating directions; visitors can move the mouse, scroll or swipe to shuffle them, and tap a product to open it. Reduced-motion visitors get static rows."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold out products",
      "default": false
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show brand",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout and motion"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0,
      "max": 400,
      "step": 25,
      "unit": "%",
      "label": "Scroll speed",
      "default": 100
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 10,
      "max": 50,
      "step": 2,
      "label": "Products per row",
      "default": 28
    },
    {
      "type": "range",
      "id": "rows_desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Rows on screen (desktop)",
      "info": "How many rows fit in the first screen. Image height adjusts to match.",
      "default": 3
    },
    {
      "type": "range",
      "id": "rows_mobile",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Rows on screen (mobile)",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Product wall"
    }
  ]
}
{% endschema %}
