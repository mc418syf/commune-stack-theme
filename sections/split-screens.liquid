          "min": 0,
          "max": 60,
          "step": 5,
          "unit": "%",
          "label": "Darken media",
          "default": 0
        },
        {
          "type": "header",
          "content": "Second asset (right on desktop, bottom on mobile)"
        },
        {
          "type": "select",
          "id": "b_media_type",
          "label": "Media",
          "options": [
            {
              "value": "image",
