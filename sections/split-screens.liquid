          "id": "b_text_style",
          "label": "Text style",
          "options": [
            {
              "value": "highlight",
              "label": "Highlighted (boxed)"
            },
            {
              "value": "plain",
              "label": "Plain"
            }
          ],
          "default": "highlight"
        },
        {
