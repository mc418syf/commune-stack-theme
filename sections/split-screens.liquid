{%- liquid
  assign section_color = section.settings.color_scheme
  assign prefixes = 'a_,b_' | split: ','
-%}

<section
  class="split bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section_color }}"
  data-split-screens
  data-snap="{{ section.settings.snap }}"
  style="--split-h-desktop: {{ section.settings.height_desktop }}vh; --split-h-mobile: {{ section.settings.height_mobile }}svh; --split-gap: {{ section.settings.gap }}px;"
>
  {%- for block in section.blocks -%}
    <div class="split__screen" {{ block.shopify_attributes }}>
      {%- for prefix in prefixes -%}
        {%- liquid
          assign key = prefix | append: 'media_type'
          assign media_type = block.settings[key]
          assign key = prefix | append: 'image'
          assign image = block.settings[key]
          assign key = prefix | append: 'video'
          assign video = block.settings[key]
          assign key = prefix | append: 'heading'
          assign heading = block.settings[key]
          assign key = prefix | append: 'subheading'
          assign subheading = block.settings[key]
          assign key = prefix | append: 'button_label'
          assign button_label = block.settings[key]
          assign key = prefix | append: 'link'
          assign link = block.settings[key]
          assign key = prefix | append: 'text_style'
          assign text_style = block.settings[key]
          assign key = prefix | append: 'text_color'
          assign text_color = block.settings[key]
          assign key = prefix | append: 'text_position'
          assign text_position = block.settings[key]
          assign key = prefix | append: 'overlay'
          assign overlay = block.settings[key]
          assign alt_text = image.alt | default: heading
          assign eager = false
          assign loading_attr = 'lazy'
          if forloop.parentloop.first and section.index <= 2
            assign eager = true
            assign loading_attr = 'eager'
          endif
          assign tag = 'div'
          if link != blank
            assign tag = 'a'
          endif
        -%}

        <{{ tag }}
          class="split__panel"
          {% if link != blank %}href="{{ link }}"{% endif %}
          style="--split-text-color: {{ text_color }}; --split-overlay: {{ overlay | divided_by: 100.0 }};"
        >
          {%- if media_type == 'video' and video != blank -%}
            <video
              class="split__media"
              muted
              loop
              playsinline
              preload="{% if eager %}auto{% else %}none{% endif %}"
              {% if eager %}autoplay{% endif %}
              {% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 1600 }}"{% endif %}
              aria-label="{{ heading | default: video.alt | escape }}"
            >
              {%- for source in video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif image != blank -%}
            {{
              image
              | image_url: width: 1600
              | image_tag:
                loading: loading_attr,
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'split__media',
                alt: alt_text
            }}
          {%- else -%}
            <div class="split__media split__placeholder" aria-hidden="true"></div>
          {%- endif -%}

          {%- if heading != blank or subheading != blank or button_label != blank -%}
            <div class="split__text split__text--{{ text_position }} split__text--{{ text_style }}">
              {%- if heading != blank -%}
                <h2 class="split__heading"><span>{{ heading | escape }}</span></h2>
              {%- endif -%}
              {%- if subheading != blank -%}
                <p class="split__sub"><span>{{ subheading | escape }}</span></p>
              {%- endif -%}
              {%- if button_label != blank -%}
                <span class="split__button">{{ button_label | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  {%- endfor -%}
</section>

{{ 'split-screens.css' | asset_url | stylesheet_tag }}
<script src="{{ 'split-screens.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Split screens",
  "tag": "section",
  "class": "split-screens-section",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each screen shows two images or videos side by side on desktop. On mobile each screen is one page with the two stacked, and scrolling snaps from screen to screen. Add a screen for each pair."
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Screen height (desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Screen height (mobile)",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Space between the two assets",
      "default": 0
    },
    {
      "type": "select",
      "id": "snap",
      "label": "Snap scrolling",
      "options": [
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "all",
          "label": "Mobile and desktop"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ],
      "default": "mobile",
      "info": "Each swipe or scroll lands on the next screen. Turned off inside the theme editor."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "Color scheme",
      "info": "Colors the highlighted text boxes."
    }
  ],
  "blocks": [
    {
      "type": "screen",
      "name": "Screen",
      "limit": 10,
      "settings": [
        {
          "type": "header",
          "content": "First asset (left on desktop, top on mobile)"
        },
        {
          "type": "select",
          "id": "a_media_type",
          "label": "Media",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "a_image",
          "label": "Image",
          "info": "Also used as the poster while a video loads."
        },
        {
          "type": "video",
          "id": "a_video",
          "label": "Video",
          "info": "Uploaded to Shopify (Content > Files). Plays muted on a loop."
        },
        {
          "type": "text",
          "id": "a_heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "a_subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "a_button_label",
          "label": "Button text",
          "info": "Leave empty to hide the button."
        },
        {
          "type": "url",
          "id": "a_link",
          "label": "Link",
          "info": "The whole panel links here."
        },
        {
          "type": "select",
          "id": "a_text_style",
          "label": "Text style",
          "options": [
            {
              "value": "highlight",
              "label": "Highlighted (boxed)"
            },
            {
              "value": "plain",
              "label": "Plain"
            }
          ],
          "default": "highlight"
        },
        {
          "type": "color",
          "id": "a_text_color",
          "label": "Plain text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "a_text_position",
          "label": "Text position",
          "options": [
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top",
              "label": "Top"
            }
          ],
          "default": "bottom"
        },
        {
