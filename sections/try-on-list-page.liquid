{%- assign section_color = section.settings.color_scheme | default: 'scheme1' -%}
{%- liquid
  if settings.button_color == 'transparent_background_text_border'
    assign cta_button_classes = 'border-text border-scheme-text bg-scheme-text text-scheme-background hover:border-scheme-accent hover:bg-scheme-accent hover:text-scheme-accent-contrast'
  else
    assign cta_button_classes = 'border-text border-button bg-button text-button hover:border-button-hover hover:bg-button-hover hover:text-button-hover'
  endif
-%}

<div
  class="bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section_color }}"
  x-data="{
    get items() { return this.$store.tryOnList.items },
    get count() { return this.$store.tryOnList.count },
    get calendlyUrl() {
      const base = 'https://calendly.com/commune237/showroomappointment';
      const items = this.$store.tryOnList.items;
      if (items.length === 0) return base;
      const params = new URLSearchParams();
      const pieces = items.map(i =>
        i.variantTitle ? i.title + ' (' + i.variantTitle + ')' : i.title
      ).join(', ');
      params.set('a2', pieces);
      {%- if customer %}
        params.set('name', {{ customer.first_name | append: ' ' | append: customer.last_name | json }});
        params.set('email', {{ customer.email | json }});
      {%- endif %}
      return base + '?' + params.toString();
    }
  }"
>

  {% comment %} ── Items view ── {% endcomment %}
  <div x-show="count > 0">
    <div class="pt-theme-double">

      {% comment %} Column headers {% endcomment %}
      <div class="lg:grid lg:grid-cols-12 lg:px-4 gap-4 items-end px-2 py-2">
        <div class="lg:col-span-5">
          <h1 class="font-heading text-heading-standard page-title-mobile-bold">
            {{ section.settings.title | default: 'Try In-Store' }}
          </h1>
        </div>
        <div class="col-span-2 hidden text-center font-normal lg:block">
          {{ 'cart.label.price' | t }}
        </div>
        <div class="col-span-5 hidden lg:block"></div>
      </div>

      {% comment %} Item rows {% endcomment %}
      <ul>
        <template x-for="item in items" :key="item.variantId">
          <li class="grid grid-cols-10 gap-2 max-lg:auto-rows-max lg:grid-cols-12 lg:gap-4 border-t-gridline border-gridline-color py-2 px-section-horizontal-spacing">

            {% comment %} ── Image ── {% endcomment %}
            <div class="max-lg:col-span-2 max-lg:row-span-2 col-span-1">
              <a :href="item.url" class="block">
                <img
                  x-show="item.image"
                  :src="item.image"
                  :alt="item.title"
                  style="width:100%; height:auto; object-fit:cover; aspect-ratio:2/3; display:block;"
                >
              </a>
            </div>

            {% comment %} ── Info ── {% endcomment %}
            <div class="col-span-5 max-lg:row-span-1 lg:col-span-4">
              <div class="flex">
                <div>
                  <p class="text-xs uppercase tracking-wide mb-1" x-show="item.vendor" x-text="item.vendor"></p>
                  <a class="inline-block" :href="item.url" x-text="item.title"></a>
                  <p class="text-sm" x-show="item.variantTitle" x-text="item.variantTitle"></p>
                  <a
                    @click.prevent="$store.tryOnList.remove(item.variantId)"
                    class="hidden lg:block mt-2 cursor-pointer"
                    href="#"
                  >
                    <small>{{ 'cart.general.remove' | t }}</small>
                  </a>
                </div>
              </div>
            </div>

            {% comment %} ── Price (desktop) ── {% endcomment %}
            <div class="text-center max-lg:hidden lg:col-span-2">
              <span x-text="item.price"></span>
            </div>

            {% comment %} ── Mobile row 2: price + remove ── {% endcomment %}
            <div class="col-span-5 max-lg:row-span-1 lg:col-span-5">
              <div class="flex justify-start items-start lg:hidden">
                <span x-text="item.price"></span>
              </div>
              <a
                @click.prevent="$store.tryOnList.remove(item.variantId)"
                class="block lg:hidden mt-2 cursor-pointer"
                href="#"
              >
                <small>{{ 'cart.general.remove' | t }}</small>
              </a>
            </div>

            {% comment %} ── Top-right spacer (mobile: remove col position) ── {% endcomment %}
            <div class="max-lg:col-start-8 max-lg:col-span-3 max-lg:row-start-1 col-span-2 text-right"></div>

          </li>
        </template>
      </ul>

    </div>
  </div>

  {% comment %} ── Empty state ── {% endcomment %}
  <div
    x-show="count === 0"
    class="py-section-vertical-spacing px-section-horizontal-spacing"
  >
    <h1 class="font-heading text-heading-standard page-title-mobile-bold">
      {{ section.settings.title | default: 'Try In-Store' }}
    </h1>
    <div class="mt-8">
      <p class="mb-8">
        {{ section.settings.empty_text | default: 'Your try-on list is empty. Browse products and tap Try In-Store to add pieces for your showroom visit.' }}
      </p>
      <a
        class="theme-link inline-block text-scheme-text hover:text-scheme-accent"
        href="{{ section.settings.empty_cta_url | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.empty_cta_label | default: 'Continue browsing' }}
      </a>
    </div>
  </div>

  {% comment %} ── Footer ── {% endcomment %}
  <div
    x-show="count > 0"
    class="border-t-gridline border-gridline-color text-scheme-text bg-scheme-background"
  >
    <div class="md:grid md:grid-cols-12 px-section-horizontal-spacing pb-theme">
      <div class="mt-4 text-center md:col-span-5 md:col-start-8 lg:col-span-4 lg:col-start-9">

        <p class="mb-4 text-sm text-left">
          {{ section.settings.footer_note | default: 'Our team will prepare each piece before your visit. No commitment to purchase.' }}
        </p>

        <a
          x-bind:href="calendlyUrl"
          class="mt-2 w-full cursor-pointer rounded-button p-2 [text-transform:var(--button-text-transform)] after:content-[var(--button-after-content)] lg:mt-0 {{ cta_button_classes }} inline-flex items-center justify-center gap-2"
        >
          {{ section.settings.cta_label | default: 'Book Fitting Appointment' }}
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" style="flex-shrink:0;">
            <path d="M9 1L13 5L9 9M1 5H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </a>

        <div class="mt-4 lg:text-right">
          <a
            @click.prevent="$store.tryOnList.clear()"
            class="theme-link inline-block text-scheme-text hover:text-scheme-accent cursor-pointer"
            href="#"
          >
            <small>{{ section.settings.clear_label | default: 'Clear list' }}</small>
          </a>
        </div>

      </div>
    </div>
  </div>

</div>

<style>
  /* Mobile: bigger + bold page title; desktop unchanged */
  @media (max-width: 1023px) {
    .page-title-mobile-bold {
      font-weight: 700 !important;
      font-size: 2rem !important;
      line-height: 1.15 !important;
      letter-spacing: -0.01em;
    }
  }
</style>

{% schema %}
{
  "name": "Try In-Store list",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page heading",
      "default": "Try In-Store"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Your try-on list is empty. Browse products and tap Try In-Store to add pieces for your showroom visit."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Empty CTA label",
      "default": "Continue browsing"
    },
    {
      "type": "url",
      "id": "empty_cta_url",
      "label": "Empty CTA link"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "textarea",
      "id": "footer_note",
      "label": "Footer note",
      "default": "Our team will prepare each piece before your visit. No commitment to purchase."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Book appointment label",
      "default": "Book Fitting Appointment"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear list label",
      "default": "Clear list"
    }
  ],
  "presets": [
    {
      "name": "Try In-Store list"
    }
  ]
}
{% endschema %}
