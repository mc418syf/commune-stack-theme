{%- liquid
  assign menu_style = layout | split: 'menu_' | last
  assign counter = 0

  if menu_style == 'center' or menu_style == 'below'
    assign list_classes = 'justify-center'
  elsif menu_style == 'left'
    assign list_classes = 'justify-start'
  elsif menu_style == 'right'
    assign list_classes = 'justify-end'
  endif

  assign link_all = section.settings.show_all_navigation_links
  assign dropdown_text_align = section.settings.dropdown_text_align
  case dropdown_text_align
    when 'text-left'
      assign single_level_menu_flex_justify = 'justify-start'
    when 'text-center'
      assign single_level_menu_flex_justify = 'justify-center'
    when 'text-right'
      assign single_level_menu_flex_justify = 'justify-end'
  endcase
-%}

<ul class="menu {{ list_classes }}" style="display:flex; flex-wrap:wrap; align-items:center; list-style:none; margin:0; padding:0; column-gap:0.25rem; line-height:1;">
  {%- for link in linklists[section.settings.menu].links -%}
    <li class="menu-item relative {% if link.links != blank %}has-dropdown{% endif %}" style="display:flex; align-items:center;">
      <a href="{{ link.url }}" class="{{ item_spacing }}{% if settings.header_uppercase %} uppercase{% endif %}" style="display:inline-flex; align-items:center; justify-content:center; height:48px; padding-top:0; padding-bottom:0; padding-left:0.75rem; padding-right:0.75rem; line-height:1;">
        {{- link.title -}}
      </a>
      {% if link.links != blank %}
        <ul class="submenu absolute top-full left-0 z-20 hidden bg-scheme-background text-scheme-text shadow-lg min-w-[200px]">
          {% for child_link in link.links %}
            <li class="border-b border-gridline-color last:border-b-0">
              <a href="{{ child_link.url }}" class="block px-4 py-2 hover:bg-gridline-color">{{ child_link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {%- endfor -%}
</ul>

<style>
  .menu-item:hover > .submenu {
    display: block;
  }
</style>
