{%- comment -%}
  Filter panel. Opens downward under the top bar and pushes the page down (see assets/plp-filter.css).
  On collection and search pages it holds search, the archive list (Designer on the left; Category and Gender on the right) and a footer row.
  On every other page it holds only search.
  Designer = vendor, Category = the Category_ tags, Gender = the mens / womens tags (all set up in Shopify Search & Discovery).
  assets/plp-filter.js applies each change live and keeps the URL in sync. Without JavaScript the panel is a plain GET form.
{%- endcomment -%}
{%- liquid
  assign filter_source = nil
  assign form_action = routes.search_url
  assign pieces = 0
  if template.name == 'collection'
    assign filter_source = collection.filters
    assign form_action = collection.url
    assign pieces = collection.products_count
  elsif template.name == 'search'
    assign filter_source = search.filters
    assign pieces = search.results_count
  endif

  assign has_filters = false
  if filter_source != blank
    assign has_filters = true
  endif

  assign f_des = nil
  assign f_cat = nil
  assign f_gen = nil
  assign avail_on = false
  if has_filters
    for f in filter_source
      assign fl = f.label | downcase
      if f.param_name == 'filter.p.vendor'
        assign f_des = f
      elsif fl contains 'categ' or f.param_name == 'filter.p.product_type'
        assign f_cat = f
      elsif fl contains 'gender'
        assign f_gen = f
      elsif f.param_name == 'filter.v.availability'
        assign avail_value = f.values | where: 'value', '1' | first
        if avail_value.active
          assign avail_on = true
        endif
      endif
    endfor
  endif

  assign clear_url = form_action
  if template.name == 'search'
    assign q_enc = search.terms | url_encode
    assign clear_url = routes.search_url | append: '?q=' | append: q_enc
  endif
-%}

<section
  class="plp-fp"
  id="plp-fp"
  data-plp-fp
  {% unless has_filters %}data-plp-search-only{% endunless %}
  aria-label="{% if has_filters %}Filter{% else %}Search{% endif %}"
  inert
>
  <div class="plp-fp__in">
    <div class="plp-fp__gap" aria-hidden="true"></div>
    <div class="plp-fp__sheet">
      <form class="plp-s" action="{{ routes.search_url }}" method="get" role="search" data-plp-search>
        <div class="plp-s__row">
          <label class="plp-sr" for="plp-s-q">Search pieces</label>
          <div class="plp-s__fw">
            <input id="plp-s-q" class="plp-s__q" type="search" name="q" placeholder="Search pieces" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-plp-q>
          </div>
          <svg class="plp-s__ic" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><circle cx="6.8" cy="6.8" r="4.8"/><path d="M10.4 10.4 14.5 14.5" stroke-linecap="round"/></svg>
          <button type="button" class="plp-s__x" data-plp-q-clear aria-label="Clear search" hidden>
            <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M2 2 12 12M12 2 2 12" stroke-linecap="round"/></svg>
          </button>
        </div>
        <input type="hidden" name="options[prefix]" value="last">
        <div class="plp-s__r" data-plp-results aria-live="polite"></div>
      </form>

      {%- if has_filters -%}
        <form class="plp-f" action="{{ form_action }}" method="get" data-plp-filters>
          {%- if template.name == 'search' -%}
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
          {%- endif -%}
          {%- assign sort_now = collection.sort_by | default: search.sort_by -%}
          {%- if sort_now != blank -%}
            <input type="hidden" name="sort_by" value="{{ sort_now | escape }}">
          {%- endif -%}
          {%- if avail_on -%}
            <input type="hidden" name="filter.v.availability" value="1">
          {%- endif -%}

          <div class="plp-f__cols plp-f__js" data-plp-cols>
            {%- if f_des != blank -%}
              <div class="plp-f__c plp-f__c--des">
                <h3 class="plp-h" id="plp-h-des">&lt;Designer&gt;</h3>
                <div class="plp-f__list plp-f__list--des" role="group" aria-labelledby="plp-h-des">
                  {%- assign vals = f_des.values | sort_natural: 'label' -%}
                  {%- for v in vals -%}
                    {%- capture lbl -%}{%- render 'plp-value-label', kind: 'designer', label: v.label -%}{%- endcapture -%}
                    <button
                      type="button"
                      class="plp-o plp-o--single"
                      aria-pressed="{{ v.active }}"
                      data-plp-opt
                      data-single
                      data-param="{{ v.param_name }}"
                      data-value="{{ v.value | escape }}"
                      {% if v.count == 0 and v.active == false %}aria-disabled="true"{% endif %}
                    >
                      <span class="plp-o__m" aria-hidden="true"></span>
                      <span class="plp-o__l">{{ lbl | strip }}</span>
                      <span class="plp-o__c">[{{ v.count }}]</span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            {%- if f_cat != blank or f_gen != blank -%}
              <div class="plp-f__c plp-f__c--rest">
                {%- if f_cat != blank -%}
                  <h3 class="plp-h plp-h--rule" id="plp-h-cat">&lt;Category&gt;</h3>
                  <div class="plp-f__list" role="group" aria-labelledby="plp-h-cat">
                    {%- assign vals = f_cat.values | sort_natural: 'label' -%}
                    {%- for v in vals -%}
                      {%- capture lbl -%}{%- render 'plp-value-label', kind: 'category', label: v.label -%}{%- endcapture -%}
                      <button
                        type="button"
                        class="plp-o plp-o--multi"
                        aria-pressed="{{ v.active }}"
                        data-plp-opt
                        data-param="{{ v.param_name }}"
                        data-value="{{ v.value | escape }}"
                        {% if v.count == 0 and v.active == false %}aria-disabled="true"{% endif %}
                      >
                        <span class="plp-o__m" aria-hidden="true"></span>
                        <span class="plp-o__l">{{ lbl | strip }}</span>
                        <span class="plp-o__c">[{{ v.count }}]</span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                {%- if f_gen != blank -%}
                  <h3 class="plp-h plp-h--rule plp-h--gender" id="plp-h-gen">&lt;Gender&gt;</h3>
                  <div class="plp-f__list" role="group" aria-labelledby="plp-h-gen">
                    {%- assign vals = f_gen.values | sort_natural: 'label' -%}
                    {%- for v in vals -%}
                      {%- capture lbl -%}{%- render 'plp-value-label', kind: 'gender', label: v.label -%}{%- endcapture -%}
                      <button
                        type="button"
                        class="plp-o plp-o--multi"
                        aria-pressed="{{ v.active }}"
                        data-plp-opt
                        data-param="{{ v.param_name }}"
                        data-value="{{ v.value | escape }}"
                        {% if v.count == 0 and v.active == false %}aria-disabled="true"{% endif %}
                      >
                        <span class="plp-o__m" aria-hidden="true"></span>
                        <span class="plp-o__l">{{ lbl | strip }}</span>
                        <span class="plp-o__c">[{{ v.count }}]</span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} No JavaScript: the same choices as plain inputs and a visible submit button {%- endcomment -%}
          <noscript>
            <style>
              .plp-f__js { display: none !important; }
              .plp-fp { max-height: none !important; opacity: 1 !important; visibility: visible !important; }
            </style>
            <div class="plp-f__plain">
              {%- assign pairs = 'des,cat,gen' | split: ',' -%}
              {%- for pair in pairs -%}
                {%- liquid
                  case pair
                    when 'des'
                      assign pf = f_des
                      assign pk = 'designer'
                      assign pt = 'radio'
                    when 'cat'
                      assign pf = f_cat
                      assign pk = 'category'
                      assign pt = 'checkbox'
                    else
                      assign pf = f_gen
                      assign pk = 'gender'
                      assign pt = 'checkbox'
                  endcase
                -%}
                {%- if pf != blank -%}
                  <fieldset class="plp-f__fs">
                    <legend class="plp-h">&lt;{{ pk | capitalize }}&gt;</legend>
                    {%- assign vals = pf.values | sort_natural: 'label' -%}
                    {%- for v in vals -%}
                      {%- capture lbl -%}{%- render 'plp-value-label', kind: pk, label: v.label -%}{%- endcapture -%}
                      <label class="plp-o"><input type="{{ pt }}" name="{{ v.param_name }}" value="{{ v.value | escape }}"{% if v.active %} checked{% endif %}> {{ lbl | strip }} [{{ v.count }}]</label>
                    {%- endfor -%}
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
              <button type="submit" class="plp-f__submit">Apply</button>
            </div>
          </noscript>

          <div class="plp-f__foot">
            <a class="plp-f__clear" href="{{ clear_url }}" data-plp-clear>Clear all</a>
            <span class="plp-f__n" role="status" aria-live="polite"><span data-plp-n>{{ pieces }}</span> pieces</span>
          </div>
        </form>
      {%- endif -%}
    </div>
  </div>
</section>
