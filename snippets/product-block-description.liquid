{%- liquid
  assign description_label = block.settings.description_tab_label | default: 'Description'
  assign tab_gap = block.settings.tab_gap | default: 20
-%}

<div
  class="product-tabs mt-8"
  x-data="{ active: 0 }"
  x-cloak
  style="--tab-gap: {{ tab_gap }}px;"
  {{ block.shopify_attributes }}
>
  {% comment %} ── Tab labels ── {% endcomment %}
  <ul
    class="product-tabs__titles flex flex-wrap border-b-gridline border-gridline-color pb-2"
    role="tablist"
    style="column-gap: var(--tab-gap); row-gap: 0.5rem;"
  >
    <li>
      <button
        type="button"
        role="tab"
        @click="active = 0"
        :aria-selected="active === 0 ? 'true' : 'false'"
        :class="active === 0 ? 'product-tabs__tab--active' : ''"
        class="product-tabs__tab font-heading uppercase tracking-wide cursor-pointer pb-1 border-b border-transparent"
      >
        {{ description_label | upcase }}
      </button>
    </li>

    {%- assign tab_idx = 1 -%}
    {%- for i in (2..6) -%}
      {%- assign title_key = 'tab_' | append: i | append: '_title' -%}
      {%- assign title = block.settings[title_key] -%}
      {%- if title != blank -%}
        <li>
          <button
            type="button"
            role="tab"
            @click="active = {{ tab_idx }}"
            :aria-selected="active === {{ tab_idx }} ? 'true' : 'false'"
            :class="active === {{ tab_idx }} ? 'product-tabs__tab--active' : ''"
            class="product-tabs__tab font-heading uppercase tracking-wide cursor-pointer pb-1 border-b border-transparent{% if block.settings.tab_titles_bold %} font-bold{% endif %}"
          >
            {{ title | upcase }}
          </button>
        </li>
        {%- assign tab_idx = tab_idx | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {% comment %} ── Tab content panels ── {% endcomment %}
  <div class="product-tabs__content">
    <div
      role="tabpanel"
      x-show="active === 0"
      x-data="RTE"
      class="rte py-4"
    >
      {{ product.description }}
    </div>

    {%- assign tab_idx = 1 -%}
    {%- for i in (2..6) -%}
      {%- assign title_key = 'tab_' | append: i | append: '_title' -%}
      {%- assign content_key = 'tab_' | append: i | append: '_content' -%}
      {%- assign title = block.settings[title_key] -%}
      {%- assign content = block.settings[content_key] -%}
      {%- if title != blank -%}
        <div
          role="tabpanel"
          x-show="active === {{ tab_idx }}"
          x-data="RTE"
          class="rte py-4"
          style="display: none;"
        >
          {{ content }}
        </div>
        {%- assign tab_idx = tab_idx | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% comment %} ── No-JS fallback ── {% endcomment %}
<noscript>
  <div class="mt-8">
    <h2 class="font-heading text-base uppercase tracking-wide mt-6 mb-2">{{ description_label | upcase }}</h2>
    <div class="rte">{{ product.description }}</div>
    {%- for i in (2..6) -%}
      {%- assign title_key = 'tab_' | append: i | append: '_title' -%}
      {%- assign content_key = 'tab_' | append: i | append: '_content' -%}
      {%- assign title = block.settings[title_key] -%}
      {%- if title != blank -%}
        <h2 class="font-heading text-base uppercase tracking-wide mt-6 mb-2">{{ title | upcase }}</h2>
        <div class="rte">{{ block.settings[content_key] }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</noscript>

<style>
  .product-tabs__tab {
    color: var(--color-scheme-text);
    opacity: 0.5;
    background: none;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    padding-left: 0;
    padding-right: 0;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .product-tabs__tab:hover { opacity: 0.85; }
  .product-tabs__tab--active {
    opacity: 1 !important;
    border-bottom-color: currentColor !important;
  }

  /* Measurement-style tables in any tab — clean, no outer border */
  .product-tabs__content .rte table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4px;
  }
  .product-tabs__content .rte table td,
  .product-tabs__content .rte table th {
    padding: 8px 12px 8px 0;
    border: 0;
    border-bottom: 1px solid var(--color-gridline, currentColor);
    text-align: left;
    font-weight: 400;
    vertical-align: top;
  }
  .product-tabs__content .rte table tr:last-child td,
  .product-tabs__content .rte table tr:last-child th {
    border-bottom: 0;
  }
  .product-tabs__content .rte table tr:first-child td,
  .product-tabs__content .rte table tr:first-child th {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }
</style>
