{%- liquid
  # Gather all product_tab blocks from the surrounding section.
  # The first tab is always the product description (auto-populated).
  # Additional tabs are merchant-editable via the theme editor.
  assign description_label = block.settings.description_tab_label | default: 'Description'

  assign tab_blocks = ''
  for b in section.blocks
    if b.type == 'product_tab'
      assign tab_blocks = tab_blocks | append: b.id | append: '|'
    endif
  endfor
-%}

<div
  class="product-tabs mt-8"
  x-data="{ active: 0 }"
  x-cloak
  {{ block.shopify_attributes }}
>
  {% comment %} ── Tab labels ── {% endcomment %}
  <ul
    class="product-tabs__titles flex flex-wrap gap-x-6 gap-y-2 border-b-gridline border-gridline-color pb-2"
    role="tablist"
  >
    <li>
      <button
        type="button"
        role="tab"
        @click="active = 0"
        :aria-selected="active === 0 ? 'true' : 'false'"
        :class="active === 0 ? 'product-tabs__tab--active' : ''"
        class="product-tabs__tab font-heading uppercase tracking-wide cursor-pointer pb-1 border-b border-transparent"
      >
        {{ description_label | upcase }}
      </button>
    </li>
    {%- assign tab_index = 1 -%}
    {% for b in section.blocks %}
      {% if b.type == 'product_tab' %}
        {%- assign title = b.settings.tab_title | default: 'Tab' -%}
        <li>
          <button
            type="button"
            role="tab"
            @click="active = {{ tab_index }}"
            :aria-selected="active === {{ tab_index }} ? 'true' : 'false'"
            :class="active === {{ tab_index }} ? 'product-tabs__tab--active' : ''"
            class="product-tabs__tab font-heading uppercase tracking-wide cursor-pointer pb-1 border-b border-transparent"
            {{ b.shopify_attributes }}
          >
            {{ title | upcase }}
          </button>
        </li>
        {%- assign tab_index = tab_index | plus: 1 -%}
      {% endif %}
    {% endfor %}
  </ul>

  {% comment %} ── Tab content panels ── {% endcomment %}
  <div class="product-tabs__content">
    <div
      role="tabpanel"
      x-show="active === 0"
      x-data="RTE"
      class="rte py-4"
    >
      {{ product.description }}
    </div>
    {%- assign tab_index = 1 -%}
    {% for b in section.blocks %}
      {% if b.type == 'product_tab' %}
        <div
          role="tabpanel"
          x-show="active === {{ tab_index }}"
          x-data="RTE"
          class="rte py-4"
          style="display: none;"
        >
          {{ b.settings.tab_content }}
        </div>
        {%- assign tab_index = tab_index | plus: 1 -%}
      {% endif %}
    {% endfor %}
  </div>
</div>

{% comment %} ── No-JS fallback: stack everything ── {% endcomment %}
<noscript>
  <div class="mt-8">
    <h2 class="font-heading text-base uppercase tracking-wide mt-6 mb-2">{{ description_label | upcase }}</h2>
    <div class="rte">{{ product.description }}</div>
    {% for b in section.blocks %}
      {% if b.type == 'product_tab' %}
        <h2 class="font-heading text-base uppercase tracking-wide mt-6 mb-2">{{ b.settings.tab_title | upcase }}</h2>
        <div class="rte">{{ b.settings.tab_content }}</div>
      {% endif %}
    {% endfor %}
  </div>
</noscript>

<style>
  .product-tabs__tab {
    color: var(--color-scheme-text);
    opacity: 0.5;
    background: none;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    padding-left: 0;
    padding-right: 0;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .product-tabs__tab:hover { opacity: 0.85; }
  .product-tabs__tab--active {
    opacity: 1 !important;
    border-bottom-color: currentColor !important;
  }

  /* Measurement-style tables inside any tab — clean, no outer border */
  .product-tabs__content .rte table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4px;
  }
  .product-tabs__content .rte table td,
  .product-tabs__content .rte table th {
    padding: 8px 12px 8px 0;
    border: 0;
    border-bottom: 1px solid var(--color-gridline, currentColor);
    text-align: left;
    font-weight: 400;
    vertical-align: top;
  }
  .product-tabs__content .rte table tr:last-child td,
  .product-tabs__content .rte table tr:last-child th {
    border-bottom: 0;
  }
  .product-tabs__content .rte table tr:first-child td,
  .product-tabs__content .rte table tr:first-child th {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }
</style>
