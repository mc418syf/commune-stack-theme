{%- liquid
  assign description_label = block.settings.description_tab_label | default: 'Description'
-%}

{{ 'product-record.css' | asset_url | stylesheet_tag }}

{% comment %} Mobile shows the description once, as a paragraph near the top; desktop shows it under a heading {% endcomment %}
<div class="record-lede rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

<section class="product-desc">
  <h2 class="product-desc__title">{{ description_label | upcase }}</h2>
  <div class="product-desc__body rte">{{ product.description }}</div>
</section>
