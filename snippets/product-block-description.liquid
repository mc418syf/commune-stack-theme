{%- liquid
  # Split the description into sections by <h2> tags.
  # Anything before the first <h2> is "intro" content.
  # Each <h2>...</h2> + following content becomes a tab.
  # If there are no <h2> tags, the whole description is rendered as a
  # single "Description" tab.
  assign normalized = product.description | replace: '<h2 data-mce-fragment="1">', '<h2>'
  assign parts = normalized | split: '<h2>'

  assign intro_html = ''
  assign tab_count = 0
  for part in parts
    unless part == blank
      if part contains '</h2>'
        assign tab_count = tab_count | plus: 1
      else
        assign intro_html = intro_html | append: part
      endif
    endunless
  endfor
-%}

{%- if intro_html != blank and tab_count > 0 -%}
  <div x-data="RTE" class="rte mt-8 product-tabs-intro">
    {{ intro_html }}
  </div>
{%- endif -%}

<div
  class="product-tabs mt-8"
  x-data="{ active: 0 }"
  x-cloak
  {{ block.shopify_attributes }}
>
  {% comment %} ── Tab labels (horizontal switcher) ── {% endcomment %}
  <ul
    class="product-tabs__titles flex flex-wrap gap-x-5 gap-y-2 border-b-gridline border-gridline-color pb-2"
    role="tablist"
  >
    {%- if tab_count == 0 -%}
      <li>
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="product-tabs__tab product-tabs__tab--active cursor-pointer pb-1 border-b border-transparent"
        >
          Description
        </button>
      </li>
    {%- else -%}
      {%- assign tab_index = 0 -%}
      {% for part in parts %}
        {% unless part == blank %}
          {% if part contains '</h2>' %}
            {%- assign part_parts = part | split: '</h2>' -%}
            {%- assign heading_handle = part_parts.first | handle -%}
            {%- assign idx = tab_index -%}
            <li>
              <button
                type="button"
                role="tab"
                @click="active = {{ idx }}"
                :aria-selected="active === {{ idx }} ? 'true' : 'false'"
                :class="active === {{ idx }} ? 'product-tabs__tab--active' : ''"
                class="product-tabs__tab cursor-pointer pb-1 border-b border-transparent"
                aria-controls="tab-panel-{{ heading_handle }}-{{ idx }}"
              >
                {{ part_parts.first | strip_html | strip }}
              </button>
            </li>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {% endif %}
        {% endunless %}
      {% endfor %}
    {%- endif -%}
  </ul>

  {% comment %} ── Tab content panels ── {% endcomment %}
  <div class="product-tabs__content">
    {%- if tab_count == 0 -%}
      <div
        role="tabpanel"
        x-data="RTE"
        class="rte py-4"
      >
        {{ product.description }}
      </div>
    {%- else -%}
      {%- assign tab_index = 0 -%}
      {% for part in parts %}
        {% unless part == blank %}
          {% if part contains '</h2>' %}
            {%- assign part_parts = part | split: '</h2>' -%}
            {%- assign heading_handle = part_parts.first | handle -%}
            {%- assign idx = tab_index -%}
            <div
              role="tabpanel"
              id="tab-panel-{{ heading_handle }}-{{ idx }}"
              x-show="active === {{ idx }}"
              x-data="RTE"
              class="rte py-4"
              {% if tab_index != 0 %}style="display: none;"{% endif %}
            >
              {{ part_parts.last }}
            </div>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {% endif %}
        {% endunless %}
      {% endfor %}
    {%- endif -%}
  </div>
</div>

{% comment %} ── Print / no-JS fallback ── {% endcomment %}
<noscript>
  <div class="rte mt-8">
    {{ product.description }}
  </div>
</noscript>

<style>
  .product-tabs__tab {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-scheme-text);
    opacity: 0.55;
    background: none;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    padding-left: 0;
    padding-right: 0;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .product-tabs__tab:hover { opacity: 0.85; }
  .product-tabs__tab--active {
    opacity: 1 !important;
    border-bottom-color: currentColor !important;
  }
  .product-tabs__content .rte,
  .product-tabs__content .rte p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-scheme-text);
    opacity: 0.78;
  }
  .product-tabs__content .rte p { margin-bottom: 0.6em; }
  .product-tabs__content .rte p:last-child { margin-bottom: 0; }

  /* Measurement-style tables: clean, no outer border, thin gridlines */
  .product-tabs__content .rte table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    letter-spacing: 0.02em;
    margin-top: 4px;
  }
  .product-tabs__content .rte table td,
  .product-tabs__content .rte table th {
    padding: 8px 10px 8px 0;
    border: 0;
    border-bottom: 1px solid var(--color-gridline, #d8d4cd);
    text-align: left;
    font-weight: 400;
    vertical-align: top;
  }
  .product-tabs__content .rte table tr:last-child td,
  .product-tabs__content .rte table tr:last-child th {
    border-bottom: 0;
  }
  .product-tabs__content .rte table tr:first-child td,
  .product-tabs__content .rte table tr:first-child th {
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
</style>
