{%- comment -%}
  Edge rail: left rail, top strip (switch · logo · filter summary), tools panel (Menu / Filter / Cart / Try-on) and search bar.
  Cart and Try-on lines are drawn by assets/edge-rail.js from /cart.js and $store.tryOnList.
  Params: header_logo (captured logo markup)
{%- endcomment -%}

{%- liquid
  assign cfg = section.settings
  assign show_cart = cfg.show_cart
  assign show_search = cfg.show_search
  assign show_switch = cfg.show_stock_switch
  assign tab_menu = cfg.tab_menu
  assign tab_filter = cfg.tab_filter
  assign tab_cart = cfg.tab_cart
  assign rail_menu = linklists[section.settings.edge_menu]

  assign filter_source = nil
  if template.name == 'collection'
    assign filter_source = collection.filters
  elsif template.name == 'search'
    assign filter_source = search.filters
  endif

  assign on_plp = false
  if filter_source != blank
    assign on_plp = true
  endif

  assign results_count = collection.products_count
  if template.name == 'search'
    assign results_count = search.results_count
  endif

  assign active_total = 0
  assign summary = ''
  assign avail_value = nil
  if on_plp
    for f in filter_source
      if f.param_name == 'filter.v.availability'
        assign avail_value = f.values | where: 'value', '1' | first
      endif
      if f.type != 'price_range' and f.param_name != 'filter.v.availability'
        for v in f.active_values
          assign active_total = active_total | plus: 1
          if summary == ''
            assign summary = v.label
          else
            assign summary = summary | append: ' · ' | append: v.label
          endif
        endfor
      endif
    endfor
  endif
-%}

<div class="edge-strip__inner">
  <div class="edge-strip__left">
    {%- if on_plp and template.name == 'collection' -%}
      <div class="edge-view" role="group" aria-label="View">
        <button type="button" data-plp-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-plp-view="gallery" aria-pressed="false">Gallery</button>
      </div>
    {%- endif -%}
  </div>
  <div class="edge-strip__logo">{{ header_logo }}</div>
  <div class="edge-strip__right">
    {%- if on_plp and active_total > 0 -%}
      <button type="button" class="edge-summary" data-edge-open="filter">
        <span class="edge-summary__d">&lt;{{ summary | escape }}&gt;</span>
        <span class="edge-summary__m">Filter [{{ active_total }}]</span>
      </button>
    {%- endif -%}
  </div>
</div>

<div class="edge-rail__bg" aria-hidden="true"></div>
<nav class="edge-rail" aria-label="Edge rail" data-edge-rail data-cart-count="{{ cart.item_count }}" data-hover="{% if cfg.hover_expand == false %}false{% else %}true{% endif %}">
  <div class="edge-rail__group">
    {%- if tab_menu != false -%}
    <button type="button" class="edge-rail__v" data-edge-open="menu" aria-haspopup="dialog" aria-expanded="false" aria-label="Menu">
      <span>Menu</span>
    </button>
    {%- endif -%}
    {%- if show_search != false -%}
    <button type="button" class="edge-rail__v" data-edge-search aria-label="Search">
      <span data-edge-search-label>Search</span>
    </button>
    {%- endif -%}
    {%- if on_plp and tab_filter != false -%}
    <button type="button" class="edge-rail__v" data-edge-open="filter" aria-haspopup="dialog" aria-expanded="false" aria-label="Filter">
      <span>Filter{% if active_total > 0 %} [{{ active_total }}]{% endif %}</span>
    </button>
    {%- endif -%}
  </div>
  <div class="edge-rail__group">
    {%- if show_cart != false -%}
    <button type="button" class="edge-rail__v" data-edge-open="cart" aria-haspopup="dialog" aria-expanded="false" aria-label="Cart"{% if cart.item_count == 0 %} hidden{% endif %}>
      <span>Cart [<span data-edge-count="total">{{ cart.item_count }}</span>]</span>
    </button>
    {%- endif -%}
  </div>
  <noscript>
    <ul class="edge-noscript">
      <li><a href="{{ routes.cart_url }}">Cart</a></li>
      <li><a href="{{ routes.search_url }}">Search</a></li>
    </ul>
  </noscript>
</nav>

<div class="edge-scrim" data-edge-scrim hidden></div>

<section class="edge-panel" role="dialog" aria-modal="true" aria-label="Tools" data-edge-panel data-tab="menu" tabindex="-1" hidden>
  <div class="edge-panes">
    <div role="region" id="edge-pane-menu" aria-label="Menu" data-edge-pane="menu">
      <ol class="edge-menu">
        {%- if rail_menu != blank and rail_menu.links.size > 0 -%}
          {%- for link in rail_menu.links -%}
            <li>
              <a class="edge-row" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                <span class="edge-row__l">{{ link.title }}</span>
                {%- if forloop.first and link.url contains '/collections' -%}
                  <span class="edge-row__c">[{{ collections.all.products_count }}]</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a class="edge-row" href="/collections/all"><span class="edge-row__l">Shop</span><span class="edge-row__c">[{{ collections.all.products_count }}]</span></a></li>
          <li><a class="edge-row" href="/pages/book"><span class="edge-row__l">Appointment</span></a></li>
          <li><a class="edge-row" href="/pages/information"><span class="edge-row__l">Information</span></a></li>
          <li><a class="edge-row" href="{{ routes.account_url }}"><span class="edge-row__l">Customer information</span></a></li>
        {%- endif -%}
      </ol>
      {%- assign footer_list = linklists[cfg.footer_menu] -%}
      {%- if cfg.menu_footer_links != false and footer_list != blank and footer_list.links.size > 0 -%}
        <hr class="edge-rule">
        <ul class="edge-footlinks">
          {%- for link in footer_list.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if cfg.menu_newsletter != false -%}
        <hr class="edge-rule">
        <div class="edge-news">
          {%- form 'customer', id: 'EdgeNewsletter' -%}
            {%- if form.posted_successfully? -%}
              <p class="edge-news__ok" role="status" data-edge-news-ok>Thanks for subscribing.</p>
            {%- else -%}
              {%- if form.errors -%}<div class="edge-news__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="edge-news__l" for="EdgeNewsletterEmail">Newsletter</label>
              <div class="edge-news__row">
                <input id="EdgeNewsletterEmail" type="email" name="contact[email]" placeholder="Email address" required autocomplete="email" autocapitalize="off" autocorrect="off" value="{% if customer.email != blank %}{{ customer.email }}{% endif %}">
                <button type="submit">Sign up</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
      {%- if cfg.menu_social != false -%}
        {%- assign social_accounts = 'Instagram, Facebook, X, TikTok, YouTube, Pinterest, Threads, Whatsapp, Discord, Tumblr, Snapchat, LinkedIn, Messenger, Email' | split: ', ' -%}
        {%- capture social_html -%}
          {%- for social in social_accounts -%}
            {%- assign handle = social | handleize -%}
            {%- assign key = 'social_' | append: handle | append: '_link' -%}
            {%- if settings[key] != blank -%}
              <li>
                <a href="{% if handle == 'email' %}mailto:{% endif %}{{ settings[key] }}"{% unless handle == 'email' %} target="_blank" rel="noopener"{% endunless %} aria-label="{{ social }}">
                  <span class="edge-social__icon" aria-hidden="true">
                    {%- case handle -%}
                      {%- when 'instagram' -%}{%- render 'icon-instagram' -%}
                      {%- when 'facebook' -%}{%- render 'icon-facebook' -%}
                      {%- when 'x' -%}{%- render 'icon-x' -%}
                      {%- when 'tiktok' -%}{%- render 'icon-tiktok' -%}
                      {%- when 'youtube' -%}{%- render 'icon-youtube' -%}
                      {%- when 'pinterest' -%}{%- render 'icon-pinterest' -%}
                      {%- when 'threads' -%}{%- render 'icon-threads' -%}
                      {%- when 'whatsapp' -%}{%- render 'icon-whatsapp' -%}
                      {%- when 'discord' -%}{%- render 'icon-discord' -%}
                      {%- when 'tumblr' -%}{%- render 'icon-tumblr' -%}
                      {%- when 'snapchat' -%}{%- render 'icon-snapchat' -%}
                      {%- when 'linkedin' -%}{%- render 'icon-linkedin' -%}
                      {%- when 'messenger' -%}{%- render 'icon-messenger' -%}
                      {%- when 'email' -%}{%- render 'icon-email' -%}
                    {%- endcase -%}
                  </span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if social_html contains '<li>' -%}
          <hr class="edge-rule" style="margin-top: auto;">
          <ul class="edge-social" style="margin-top: 0;">{{ social_html }}</ul>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div role="region" id="edge-pane-filter" aria-label="Filter" data-edge-pane="filter" hidden>
      <div data-edge-filters>
        {%- if on_plp -%}
          <form class="edge-filters" data-edge-filter-form onsubmit="return false">
            {%- for f in filter_source -%}
              {%- if f.type == 'price_range' or f.param_name == 'filter.v.availability' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign label = f.label
                assign label_down = f.label | downcase
                if label_down == 'vendor' or label_down == 'brand' or label_down == 'designers' or label_down == 'designer'
                  assign label = 'Designer'
                elsif label_down == 'product type' or label_down == 'type'
                  assign label = 'Category'
                endif
                assign n_active = f.active_values.size
              -%}
              <div class="edge-group" data-edge-group>
                <button type="button" class="edge-group__h" aria-expanded="false" data-edge-group-toggle>
                  <span>&lt;{{ label }}&gt;{% if n_active > 0 %} [{{ n_active }}]{% endif %}</span>
                  <span class="edge-group__s" aria-hidden="true">+</span>
                </button>
                <ul class="edge-group__list" hidden>
                  {%- for v in f.values -%}
                    <li>
                      <button
                        type="button"
                        class="edge-opt"
                        aria-pressed="{{ v.active }}"
                        data-edge-url="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}"
                        {% if v.count == 0 and v.active == false %}disabled{% endif %}
                      >
                        <span class="edge-opt__l"><span class="edge-opt__box" aria-hidden="true"></span>{{ v.label }}</span>
                        <span class="edge-opt__c">[{{ v.count }}]</span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endfor -%}
            {%- liquid
              if template.name == 'search'
                assign sort_opts = search.sort_options
                assign cur_sort = search.sort_by | default: search.default_sort_by
              else
                assign sort_opts = collection.sort_options
                assign cur_sort = collection.sort_by | default: collection.default_sort_by
              endif
            -%}
            {%- if sort_opts.size > 0 -%}
              <div class="edge-group" data-edge-group>
                <button type="button" class="edge-group__h" aria-expanded="false" data-edge-group-toggle>
                  <span>&lt;Sort by&gt;</span>
                  <span class="edge-group__s" aria-hidden="true">+</span>
                </button>
                <ul class="edge-group__list" hidden>
                  {%- for o in sort_opts -%}
                    <li>
                      <button type="button" class="edge-opt" aria-pressed="{% if o.value == cur_sort %}true{% else %}false{% endif %}" data-edge-sort="{{ o.value }}">
                        <span class="edge-opt__l"><span class="edge-opt__box" aria-hidden="true"></span>{{ o.name }}</span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </form>
          <div class="edge-switchrow">
    {%- if show_switch != false -%}
      {%- comment -%} With the Availability filter enabled in Search & Discovery the switch uses filter.v.availability; without it, it hides sold-out cards on the page. {%- endcomment -%}
      <button
        type="button"
        class="edge-switch"
        role="switch"
        {% if avail_value %}
          aria-checked="{{ avail_value.active }}"
          data-edge-switch
          data-url-add="{{ avail_value.url_to_add }}"
          data-url-remove="{{ avail_value.url_to_remove }}"
        {% else %}
          aria-checked="false"
          data-edge-switch-local
        {% endif %}
      >
        <i aria-hidden="true"></i>
        <span>Hide sold out</span>
      </button>
    {%- endif -%}
          </div>
          <div class="edge-foot" data-edge-foot="filter">
            <a class="edge-link" href="{{ collection.url | default: routes.search_url }}{% if template.name == 'search' %}?q={{ search.terms | escape }}{% endif %}" data-edge-clear>Clear all</a>
          </div>
        {%- else -%}
          <p class="edge-empty">Filters appear on collection pages. <a class="edge-link" href="/collections/all">Browse the shop</a></p>
        {%- endif -%}
      </div>
    </div>

    <div role="region" id="edge-pane-cart" aria-label="Cart" data-edge-pane="cart" hidden>
      <div data-edge-list="cart"><p class="edge-empty">Loading…</p></div>
      <section class="edge-sec" data-edge-try-sec aria-label="Try-on" hidden>
        <h3 class="edge-sec__h">Try-on [<span data-edge-count="try">0</span>]</h3>
        <div data-edge-list="try"></div>
      </section>
    </div>
  </div>
</section>

<form class="edge-search" action="{{ routes.search_url }}" method="get" role="search" data-edge-searchbar hidden>
  <div class="edge-search__field">
    <svg class="edge-search__ic" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="6.8" cy="6.8" r="4.8"/><path d="M10.4 10.4 14.5 14.5" stroke-linecap="round"/></svg>
    <input id="edge-search-input" class="edge-search__i" type="search" name="q" placeholder="Name, designer, category" autocomplete="off" data-edge-input aria-label="Search">
  </div>
  <input type="hidden" name="options[prefix]" value="last">
  <button type="button" class="edge-search__x" data-edge-search-close aria-label="Close search">×</button>
  <div class="edge-search__r" data-edge-results aria-live="polite"></div>
</form>
