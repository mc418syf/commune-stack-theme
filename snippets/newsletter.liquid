{%- assign form_id = 'Contact-' | append: section_id -%}
<section
  class="border-b-gridline border-gridline-color bg-scheme-background py-section-vertical-spacing text-scheme-text"
  data-color-scheme="{{ section_color }}"
>
  <div class="mx-auto px-section-horizontal-spacing" style="max-width: 36rem;">

    {% if section_title != blank %}
      <h2
        class="font-heading font-bold text-center"
        for="Email"
        style="font-size: calc(var(--standard-heading-size, 1.5rem) + 2px); letter-spacing: 0.02em;"
      >
        {{ section_title | escape }}
      </h2>
    {% endif %}

    {% if subheading != blank %}
      <div
        class="text-center text-sm leading-relaxed [&_a[href]]:underline [&_a[href]]:hover:text-scheme-accent{% if section_title != blank %} mt-3{% endif %}"
        style="opacity: 0.7;"
      >
        {{ subheading }}
      </div>
    {% endif %}

    <div class="mt-8">
      {% form 'customer', id: form_id %}
        {% if form.errors and template.suffix != 'contact' %}
          <div class="mb-3 text-sm text-center" style="color: rgb(var(--color-scheme-accent));">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <p
            class="text-center text-sm"
            style="opacity: 0.8; letter-spacing: 0.06em;"
          >
            {{ 'general.newsletter_form.confirmation' | t }}
          </p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div
            class="newsletter-row"
            style="display: flex; align-items: stretch; border-bottom: 1px solid currentColor;"
          >
            <label class="sr-only" for="Email-{{ section.id }}">
              {{- 'general.newsletter_form.email_placeholder' | t -}}
            </label>
            <input
              type="email"
              class="font-body block w-full bg-transparent placeholder-current"
              style="border: none; outline: none; padding: 0.55rem 0; font-size: 0.95rem; letter-spacing: 0.01em;"
              name="contact[email]"
              id="Email-{{ section.id }}"
              value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
              placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <button
              class="font-body shrink-0 hover:text-scheme-accent"
              style="border: none; background: transparent; padding: 0.55rem 0 0.55rem 1rem; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; align-self: center;"
              type="submit"
              name="commit"
              id="Subscribe"
            >
              {{ 'general.newsletter_form.button_label' | t | default: 'Subscribe' }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>
