{% comment %}
  Try In-Store Drawer
  Triggered by: window.dispatchEvent(new CustomEvent('open-try-on'))
  Rendered globally via layout/theme.liquid.
{% endcomment %}

<div
  x-data="{
    open: false,
    get calendlyUrl() {
      const base = 'https://calendly.com/commune237/showroomappointment';
      const items = this.$store.tryOnList.items;
      if (items.length === 0) return base;
      const params = new URLSearchParams();
      const pieces = items.map(i =>
        i.variantTitle ? i.title + ' (' + i.variantTitle + ')' : i.title
      ).join(', ');
      params.set('a2', pieces);
      {%- if customer %}
        params.set('name', {{ customer.first_name | append: ' ' | append: customer.last_name | json }});
        params.set('email', {{ customer.email | json }});
      {%- endif %}
      return base + '?' + params.toString();
    }
  }"
  @open-try-on.window="open = true"
  @keydown.escape.window="if (open) open = false"
>

  {% comment %} Backdrop {% endcomment %}
  <div
    x-show="open"
    x-transition:enter="transition-opacity ease duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="open = false"
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.35); z-index:9998;"
  ></div>

  {% comment %} Drawer panel {% endcomment %}
  <div
    x-show="open"
    x-transition:enter="transition ease-[cubic-bezier(0.16,1,0.3,1)] duration-500"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-[cubic-bezier(0.16,1,0.3,1)] duration-350"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="color-scheme"
    data-color-scheme="{{ settings.modal_color_scheme | default: 'default' }}"
    style="display:none; position:fixed; top:0; right:0; height:100%; width:min(420px,100vw); z-index:9999; flex-direction:column; overflow:hidden; background:rgb(var(--color-scheme-background)); color:rgb(var(--color-scheme-text)); box-shadow:-4px 0 24px rgba(0,0,0,0.12);"
    x-bind:style="open ? 'display:flex;' : 'display:none;'"
    role="dialog"
    aria-modal="true"
    aria-label="Try In-Store"
  >

    {% comment %} Header {% endcomment %}
    <div style="display:flex; align-items:center; justify-content:space-between; padding:20px 24px; border-bottom:1px solid rgba(var(--color-scheme-text)/0.1); flex-shrink:0;">
      <div>
        <p style="font-size:15px; font-weight:400; margin:0;">Try In-Store</p>
        <p
          style="font-size:11px; margin-top:3px; opacity:0.55;"
          x-text="$store.tryOnList.count > 0
            ? $store.tryOnList.count + ' piece' + ($store.tryOnList.count === 1 ? '' : 's') + ' — ready to view at the showroom'
            : 'Add pieces to book a showroom fitting'"
        ></p>
      </div>
      <button
        type="button"
        @click="open = false"
        aria-label="Close try-on list"
        style="background:none; border:none; cursor:pointer; padding:4px; font-size:22px; line-height:1; color:inherit; opacity:0.5;"
        onmouseover="this.style.opacity='1'"
        onmouseout="this.style.opacity='0.5'"
      >&times;</button>
    </div>

    {% comment %} Empty state {% endcomment %}
    <div
      x-show="$store.tryOnList.count === 0"
      style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; padding:48px 24px; text-align:center;"
    >
      <svg width="32" height="28" viewBox="0 0 24 24" fill="none" style="opacity:0.18;" xmlns="http://www.w3.org/2000/svg">
        <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M12 4a2 2 0 1 1 0 4m0-4a2 2 0 1 0 0 4m0-4v4m0 0L3 18h18L12 8Z"/>
      </svg>
      <p style="font-size:13px; line-height:1.6; opacity:0.55; max-width:240px;">
        No items yet. Browse products and tap <em>Try In-Store</em> to add pieces you'd like to fit at our showroom.
      </p>
      <button
        type="button"
        @click="open = false"
        style="background:none; border:none; border-bottom:1px solid currentColor; padding-bottom:2px; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; cursor:pointer; color:inherit; margin-top:4px;"
      >
        Browse the archive
      </button>
    </div>

    {% comment %} Items list {% endcomment %}
    <div
      x-show="$store.tryOnList.count > 0"
      style="flex:1; overflow-y:auto; overscroll-behavior:contain;"
    >
      <template x-for="item in $store.tryOnList.items" :key="item.variantId">
        <div style="display:flex; gap:16px; padding:16px 24px; border-bottom:1px solid rgba(var(--color-scheme-text)/0.08); align-items:flex-start;">

          {% comment %} Thumbnail {% endcomment %}
          <a :href="item.url" @click="open = false" style="flex-shrink:0; display:block;">
            <div style="width:72px; height:96px; background:rgba(var(--color-scheme-text)/0.06); overflow:hidden; border-radius:2px;">
              <img
                x-show="item.image"
                :src="item.image"
                :alt="item.title"
                style="width:100%; height:100%; object-fit:cover;"
              />
            </div>
          </a>

          {% comment %} Info {% endcomment %}
          <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:3px;">
            <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; opacity:0.5; margin:0;" x-text="item.vendor"></p>
            <a
              :href="item.url"
              @click="open = false"
              style="font-size:13px; line-height:1.35; color:inherit; text-decoration:none;"
              x-text="item.title"
            ></a>
            <p
              x-show="item.variantTitle"
              style="font-size:11px; margin:0; opacity:0.55;"
              x-text="item.variantTitle"
            ></p>
            <p style="font-size:12px; margin-top:4px; opacity:0.6;" x-text="item.price"></p>
          </div>

          {% comment %} Remove {% endcomment %}
          <button
            type="button"
            @click="$store.tryOnList.remove(item.variantId)"
            aria-label="Remove from try-on list"
            style="background:none; border:none; cursor:pointer; font-size:20px; line-height:1; padding:0; color:#888; flex-shrink:0;"
            onmouseover="this.style.color='currentColor'"
            onmouseout="this.style.color='#888'"
          >&times;</button>

        </div>
      </template>
    </div>

    {% comment %} Footer {% endcomment %}
    <div
      x-show="$store.tryOnList.count > 0"
      style="flex-shrink:0; border-top:1px solid rgba(var(--color-scheme-text)/0.1); padding:20px 24px 28px;"
    >
      <p style="font-size:11px; line-height:1.65; opacity:0.55; margin-bottom:16px;">
        Our team will prepare each piece before your visit. No commitment to purchase.
      </p>
      <a
        x-bind:href="calendlyUrl"
        class="theme-button"
        style="display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:14px 16px; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; box-sizing:border-box;"
      >
        Book Fitting Appointment
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
          <path d="M9 1L13 5L9 9M1 5H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </a>
      <button
        type="button"
        @click="$store.tryOnList.clear()"
        style="display:block; width:100%; margin-top:12px; background:none; border:none; cursor:pointer; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; opacity:0.45; color:inherit; padding:4px 0;"
        onmouseover="this.style.opacity='0.8'"
        onmouseout="this.style.opacity='0.45'"
      >
        Clear list
      </button>
    </div>

  </div>
</div>
