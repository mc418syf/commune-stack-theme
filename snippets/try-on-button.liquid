{%- liquid
  assign try_on_variant = product.selected_or_first_available_variant
  assign try_on_image = ''
  if product.featured_media
    assign try_on_image = product.featured_media | image_url: width: 400
  endif
  assign btn_label = label | default: 'Try In-Store'
-%}
<div class="max-w-2xl mt-3" x-data>
  <button
    type="button"
    data-try-on-pdp
    id="try-on-pdp-{{ product.id }}"
    class="add-to-cart flex w-full justify-center px-1 py-2{% if settings.button_uppercase %} uppercase{% endif %} theme-button--secondary"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ try_on_variant.id }}"
    data-variant-title="{{ try_on_variant.title | escape }}"
    data-variants="{{ product.variants | json | escape }}"
    data-title="{{ product.title | escape }}"
    data-vendor="{{ product.vendor | escape }}"
    data-price-cents="{{ try_on_variant.price }}"
    data-image="{{ try_on_image }}"
    data-url="{{ product.url }}"
    data-label="{{ btn_label | escape }}"
    data-label-added="Added to Try-On"
    onclick="tryOnPDP(this)"
    :disabled="$store.tryOnList.has({{ try_on_variant.id }})"
    :class="{ 'opacity-50 cursor-not-allowed after:content-none': $store.tryOnList.has({{ try_on_variant.id }}) }"
  >
    <span data-try-on-label>{{ btn_label }}</span>
  </button>
</div>
