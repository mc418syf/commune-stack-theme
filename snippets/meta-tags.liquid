{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  {%- liquid
    assign og_image_width = page_image.width | at_most: 1200
    assign og_image_height = og_image_width | times: 1.0 | divided_by: page_image.aspect_ratio | round
  -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: og_image_width }}">
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url: width: og_image_width }}"
  >
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: og_image_width }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}
  Structured data for search engines and AI answer engines.
  - Home: Organization + WebSite (brand entity, site search)
  - Collection: BreadcrumbList + CollectionPage with the listed products
  - Product: BreadcrumbList (the Product markup itself lives in the product sections)
{%- endcomment -%}
{%- liquid
  assign sd_description = page_description | default: shop.description
-%}
{%- comment -%} A closing brace inside a Liquid string ends the tag early on Shopify, so the search URL pattern is captured as plain text {%- endcomment -%}
{%- capture sd_search_template -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '/#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }}
          {%- if settings.logo != blank -%}
            ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if sd_description != blank -%}
            ,"description": {{ sd_description | strip_html | json }}
          {%- endif -%}
          {%- capture sd_same_as -%}
            {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link }}|{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link }}|{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}{{ settings.social_tiktok_link }}|{%- endif -%}
            {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link }}|{%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link }}|{%- endif -%}
            {%- if settings.social_x_link != blank -%}{{ settings.social_x_link }}|{%- endif -%}
          {%- endcapture -%}
          {%- assign sd_same_as_list = sd_same_as | strip | split: '|' -%}
          {%- if sd_same_as_list.size > 0 -%}
            ,"sameAs": {{ sd_same_as_list | json }}
          {%- endif -%}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '/#website' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ sd_search_template | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'collection' and collection.handle != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
            { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
          ]
        },
        {
          "@type": "CollectionPage",
          "name": {{ collection.title | json }},
          "url": {{ canonical_url | json }},
          {%- if collection.description != blank -%}
            "description": {{ collection.description | strip_html | strip_newlines | truncate: 500 | json }},
          {%- endif -%}
          "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
          "mainEntity": {
            "@type": "ItemList",
            "numberOfItems": {{ collection.products_count }},
            "itemListElement": [
              {%- for product in collection.products limit: 24 -%}
                {
                  "@type": "ListItem",
                  "position": {{ forloop.index }},
                  "url": {{ shop.url | append: product.url | json }},
                  "name": {{ product.vendor | append: ' ' | append: product.title | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  {%- liquid
    assign sd_vendor_handle = product.vendor | handleize
    assign sd_vendor_collection = collections[sd_vendor_handle]
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
        {%- if sd_vendor_collection.handle != blank -%}
          { "@type": "ListItem", "position": 2, "name": {{ sd_vendor_collection.title | json }}, "item": {{ shop.url | append: sd_vendor_collection.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- else -%}
          { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
