{%- comment -%}
  Archive record block above the Add to cart bar: the measurements, Condition and Material.
  Condition comes from custom.condition, or the block's default_condition when the product has none.
{%- endcomment -%}

{{ 'product-record.css' | asset_url | stylesheet_tag }}

{%- capture record_html -%}
  {%- render 'product-record', product: product, condition: block.settings.default_condition -%}
{%- endcapture -%}
{%- if record_html contains 'record__row' -%}
  <div class="record-block">{{ record_html }}</div>
{%- endif -%}
