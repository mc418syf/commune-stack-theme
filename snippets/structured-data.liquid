{%- comment -%}
  Structured data for search engines and AI answer engines.
  - Home: Organization + WebSite (brand entity, site search)
  - Collection: BreadcrumbList + CollectionPage with the listed products
  - Product: BreadcrumbList (the Product markup itself lives in the product sections)
{%- endcomment -%}
{%- liquid
  assign sd_description = page_description | default: shop.description
-%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '/#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }}
          {%- if settings.logo != blank -%}
            ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if sd_description != blank -%}
            ,"description": {{ sd_description | strip_html | json }}
          {%- endif -%}
          {%- capture sd_same_as -%}
            {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link }}|{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link }}|{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}{{ settings.social_tiktok_link }}|{%- endif -%}
            {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link }}|{%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link }}|{%- endif -%}
            {%- if settings.social_x_link != blank -%}{{ settings.social_x_link }}|{%- endif -%}
          {%- endcapture -%}
          {%- assign sd_same_as_list = sd_same_as | strip | split: '|' -%}
          {%- if sd_same_as_list.size > 0 -%}
            ,"sameAs": {{ sd_same_as_list | json }}
          {%- endif -%}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '/#website' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'collection' and collection.handle != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
            { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
          ]
        },
        {
          "@type": "CollectionPage",
          "name": {{ collection.title | json }},
          "url": {{ canonical_url | json }},
          {%- if collection.description != blank -%}
            "description": {{ collection.description | strip_html | strip_newlines | truncate: 500 | json }},
          {%- endif -%}
          "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
          "mainEntity": {
            "@type": "ItemList",
            "numberOfItems": {{ collection.products_count }},
            "itemListElement": [
              {%- for product in collection.products limit: 24 -%}
                {
                  "@type": "ListItem",
                  "position": {{ forloop.index }},
                  "url": {{ shop.url | append: product.url | json }},
                  "name": {{ product.vendor | append: ' ' | append: product.title | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  {%- liquid
    assign sd_vendor_handle = product.vendor | handleize
    assign sd_vendor_collection = collections[sd_vendor_handle]
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
        {%- if sd_vendor_collection.handle != blank -%}
          { "@type": "ListItem", "position": 2, "name": {{ sd_vendor_collection.title | json }}, "item": {{ shop.url | append: sd_vendor_collection.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- else -%}
          { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
