<div
  class="{% unless no_border %}border-t-gridline border-gridline-color {% endunless %}bg-scheme-background px-section-horizontal-spacing pb-theme-double pt-theme text-sm text-scheme-text md:text-base"
  data-color-scheme="{{ section_color }}"
>
  <div class="grid grid-cols-3 items-center">
    <!-- Left arrow -->
    <div class="text-left">
      {% if paginate.previous.is_link %}
        <a
          class="inline-block px-2 py-1 hover:text-scheme-accent border-b-text border-transparent hover:border-scheme-text"
          href="{{ paginate.previous.url }}"
          rel="prev"
          aria-label="{{ 'general.pagination.previous' | t }}"
        >&larr;</a>
      {% else %}
        <span
          class="inline-block px-2 py-1 opacity-50 select-none"
          aria-hidden="true"
        >&larr;</span>
      {% endif %}
    </div>

    <!-- Page numbers (centered) -->
    <ul class="flex items-center justify-center gap-3">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li>
            <a
              class="inline-block px-2 py-1 border-b-text border-transparent hover:border-scheme-text"
              href="{{ part.url }}"
              aria-label="Go to page {{ part.title }}"
            >
              {{ part.title }}
            </a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li
              class="inline-block px-2 py-1 border-b-text border-scheme-text"
              aria-current="page"
            >
              {{ part.title }}
            </li>
          {%- else -%}
            <!-- Ellipsis or non-link page -->
            <li class="inline-block px-2 py-1 opacity-80">
              {{ part.title }}
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <!-- Right arrow -->
    <div class="text-right">
      {% if paginate.next.is_link %}
        <a
          class="inline-block px-2 py-1 hover:text-scheme-accent border-b-text border-transparent hover:border-scheme-text"
          href="{{ paginate.next.url }}"
          rel="next"
          aria-label="{{ 'general.pagination.next' | t }}"
        >&rarr;</a>
      {% else %}
        <span
          class="inline-block px-2 py-1 opacity-50 select-none"
          aria-hidden="true"
        >&rarr;</span>
      {% endif %}
    </div>
  </div>
</div>
