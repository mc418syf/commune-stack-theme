{% comment %}
  Commune237 — /pages/booking
  Left: stack items with remove buttons
  Right: Calendly embed (prefilled with stacked products)
  Below: Sell with Us consignment form (collapsed accordion)
{% endcomment %}

{% style %}
  .commune-booking-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .commune-booking-grid {
      grid-template-columns: 1fr 420px;
    }
  }

  .commune-appt-col {
    background: rgba(var(--color-scheme-text) / 0.02);
  }
  @media (min-width: 1024px) {
    .commune-appt-col {
      position: sticky;
      top: 56px;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
    }
  }

  .commune-stack-page-item {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.1);
  }
  .commune-stack-page-img {
    width: 96px;
    height: 128px;
    background: rgba(var(--color-scheme-text) / 0.06);
    overflow: hidden;
    flex-shrink: 0;
  }
  .commune-stack-designer {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-scheme-text) / 0.5);
    margin-bottom: 5px;
  }
  .commune-stack-name {
    font-family: var(--font-heading-family, serif);
    font-weight: 300;
    font-size: 18px;
    line-height: 1.25;
    margin-bottom: 6px;
  }
  .commune-stack-price-small {
    font-size: 12px;
    color: rgba(var(--color-scheme-text) / 0.55);
  }
  .commune-stack-note-label {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-scheme-text) / 0.5);
    margin-bottom: 5px;
    margin-top: 12px;
  }
  .commune-stack-note-area {
    width: 100%;
    border: 1px solid rgba(var(--color-scheme-text) / 0.15);
    background: transparent;
    padding: 8px 10px;
    font-size: 11px;
    font-family: inherit;
    color: inherit;
    resize: none;
    outline: none;
    height: 52px;
    letter-spacing: 0.02em;
  }
  .commune-stack-note-area::placeholder { color: rgba(var(--color-scheme-text) / 0.35); }
  .commune-stack-note-area:focus { border-color: rgba(var(--color-scheme-text) / 0.5); }

  .commune-stack-page-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    padding-top: 2px;
  }
  .commune-stack-remove {
    background: none;
    border: none;
    font-size: 20px;
    color: rgba(var(--color-scheme-text) / 0.3);
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color 0.15s;
  }
  .commune-stack-remove:hover { color: rgb(var(--color-scheme-text)); }
  .commune-stack-price-right {
    font-size: 12px;
    color: rgba(var(--color-scheme-text) / 0.55);
    white-space: nowrap;
  }

  .commune-stack-add-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-scheme-text) / 0.5);
    border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.15);
    padding-bottom: 2px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .commune-stack-add-more:hover {
    color: rgb(var(--color-scheme-text));
    border-bottom-color: rgba(var(--color-scheme-text) / 0.5);
  }

  .commune-showroom-strip {
    background: rgba(var(--color-scheme-text) / 0.04);
    padding: 14px 16px;
    border-left: 2px solid rgb(var(--color-scheme-text));
    margin-bottom: 20px;
  }
  .commune-showroom-label {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-scheme-text) / 0.5);
    margin-bottom: 6px;
  }
{% endstyle %}

<div
  class="color-scheme min-h-screen"
  data-color-scheme="default"
  x-data="CommuneBookingPage()"
  x-init="init()"
>

  {%- comment -%} ── Page header ── {%- endcomment -%}
  <div class="border-b border-current/10 px-section-horizontal-spacing py-10 text-center">
    <p class="mb-3 text-xs uppercase tracking-widest text-scheme-secondary">Commune237 · Montréal Showroom</p>
    <h1
      class="mb-3 font-normal"
      style="font-family: var(--font-heading-family, serif); font-weight: 300; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1;"
    >
      Your Stack &amp; Book
    </h1>
    <p class="mx-auto max-w-sm text-sm leading-relaxed text-scheme-secondary">
      Add notes for each piece, then book a private viewing. No commitment to purchase.
    </p>
  </div>

  {%- comment -%} ── Main two-column layout ── {%- endcomment -%}
  <div class="commune-booking-grid">

    {%- comment -%} LEFT — Stack items {%- endcomment -%}
    <div class="border-b border-current/10 px-section-horizontal-spacing py-12 lg:border-b-0 lg:border-r lg:py-14">

      <div class="mb-8">
        <p class="mb-1 text-xs uppercase tracking-widest text-scheme-secondary">Showroom Visit</p>
        <h2
          class="mb-3 font-normal"
          style="font-family: var(--font-heading-family, serif); font-weight: 300; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.15;"
        >
          Your Stack
        </h2>
        <p class="text-sm leading-relaxed text-scheme-secondary">
          These pieces will be prepared and waiting for you. Take your time — there's no pressure to purchase.
        </p>
      </div>

      {%- comment -%} Empty state {%- endcomment -%}
      <div
        x-show="$store.stack.count === 0"
        class="py-14 text-center"
        style="display: none;"
      >
        <p class="mb-2 text-sm text-scheme-secondary">Your stack is empty.</p>
        <p class="mb-6 text-xs leading-relaxed text-scheme-secondary">Browse the archive and add pieces you'd like to try on.</p>
        <a
          href="/collections/all"
          class="text-xs uppercase tracking-widest underline underline-offset-4 hover:text-scheme-accent"
        >Browse the archive →</a>
      </div>

      {%- comment -%} Items list {%- endcomment -%}
      <div
        x-show="$store.stack.count > 0"
        style="display: none;"
      >
        <template x-for="item in $store.stack.items" :key="item.variantId">
          <div class="commune-stack-page-item">

            {%- comment -%} Thumbnail {%- endcomment -%}
            <div class="commune-stack-page-img">
              <template x-if="item.image">
                <img :src="item.image" :alt="item.title" class="h-full w-full object-cover" />
              </template>
              <template x-if="!item.image">
                <div class="flex h-full w-full items-center justify-center">
                  <svg width="22" height="30" viewBox="0 0 22 30" fill="currentColor" opacity="0.1">
                    <rect width="22" height="30" rx="1"/>
                  </svg>
                </div>
              </template>
            </div>

            {%- comment -%} Info {%- endcomment -%}
            <div>
              <p class="commune-stack-designer" x-text="item.vendor"></p>
              <p class="commune-stack-name" x-text="item.title"></p>
              <p class="commune-stack-price-small" x-text="item.price"></p>
              <p class="commune-stack-note-label">Note for our team</p>
              <textarea
                class="commune-stack-note-area"
                placeholder="Fit questions, styling ideas, special requests…"
                x-model="item.note"
                @input.debounce.400ms="$store.stack.updateNote(item.variantId, $event.target.value)"
              ></textarea>
            </div>

            {%- comment -%} Remove + price {%- endcomment -%}
            <div class="commune-stack-page-right">
              <button
                class="commune-stack-remove"
                @click="$store.stack.remove(item.variantId); refreshCalendly()"
                aria-label="Remove from stack"
                type="button"
              >×</button>
              <span class="commune-stack-price-right" x-text="item.price"></span>
            </div>

          </div>
        </template>

        <div class="mt-8">
          <a href="/collections/all" class="commune-stack-add-more">
            <span>+</span>
            <span>Browse more pieces</span>
          </a>
        </div>
      </div>
    </div>

    {%- comment -%} RIGHT — Calendly + showroom info {%- endcomment -%}
    <div class="commune-appt-col px-8 py-12 lg:py-14">

      <div class="mb-6">
        <p class="mb-2 text-xs uppercase tracking-widest text-scheme-secondary">Book Your Visit</p>
        <h2
          class="mb-2 font-normal"
          style="font-family: var(--font-heading-family, serif); font-weight: 300; font-size: clamp(1.4rem, 2.5vw, 1.8rem); line-height: 1.2;"
        >
          Private Showroom<br>Appointment
        </h2>
        <p class="text-xs leading-relaxed text-scheme-secondary">
          Select a time. Our team will confirm and have your stack ready for your visit.
        </p>
      </div>

      <div class="commune-showroom-strip">
        <p class="commune-showroom-label">Showroom</p>
        <div class="text-xs leading-loose">
          <strong class="font-medium">Commune237 Montréal</strong><br>
          237 Keefer Street, Montréal<br>
          <span class="text-scheme-secondary">Tue–Sat, 11am–6pm, by appointment</span>
        </div>
      </div>

      <p class="mb-4 text-xs text-scheme-secondary">
        No payment required. No commitment to purchase.
      </p>

      {%- comment -%} Calendly inline widget {%- endcomment -%}
      <div
        id="commune-calendly"
        style="min-height: 650px;"
      ></div>
    </div>

  </div>

  {%- comment -%} ══════════════════════════════════════
       SELL WITH US — collapsed accordion
  ══════════════════════════════════════ {%- endcomment -%}
  <div class="border-t border-current/10">

    <button
      type="button"
      class="flex w-full items-center justify-between px-section-horizontal-spacing py-8 text-left transition-colors hover:bg-scheme-text/5"
      @click="showSellForm = !showSellForm"
    >
      <div>
        <p class="mb-1 text-xs uppercase tracking-widest text-scheme-secondary">Sell with Us</p>
        <p
          class="font-normal"
          style="font-family: var(--font-heading-family, serif); font-weight: 300; font-size: clamp(1.4rem, 3vw, 1.8rem);"
        >
          Consign pieces from your wardrobe
        </p>
        <p class="mt-1 text-sm text-scheme-secondary" x-show="!showSellForm" style="display:none;">
          We curate, photograph, and sell them through the archive.
        </p>
      </div>
      <span
        class="ml-6 shrink-0 text-2xl transition-transform duration-300"
        :class="showSellForm ? 'rotate-45' : ''"
      >+</span>
    </button>

    <div
      x-show="showSellForm"
      x-transition:enter="transition ease duration-300"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      style="display: none;"
    >
      <div class="mx-auto max-w-2xl px-section-horizontal-spacing pb-16">

        {%- comment -%} Success state {%- endcomment -%}
        <div x-show="submitted" class="py-12 text-center" style="display: none;">
          <p class="mb-2 text-lg" style="font-family: var(--font-heading-family, serif);">感谢你的提交！</p>
          <p class="text-sm leading-relaxed text-scheme-secondary">
            我们会在3个工作日内回复。<br>
            Thank you! We'll be in touch within 3 business days.
          </p>
        </div>

        {%- comment -%} Form {%- endcomment -%}
        <div x-show="!submitted" style="display: none;">

          {%- comment -%} ── Personal info ── {%- endcomment -%}
          <div class="mb-10">
            <p class="mb-6 border-b border-current/10 pb-3 text-xs uppercase tracking-widest text-scheme-secondary">Personal Info</p>
            <div class="flex flex-col gap-5">

              <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs uppercase tracking-widest text-scheme-secondary" for="sell-name">
                    Full Name <span class="text-scheme-accent">*</span>
                  </label>
                  <input
                    id="sell-name"
                    type="text"
                    x-model="personal.name"
                    required
                    class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                    placeholder="Jane Smith"
                  />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs uppercase tracking-widest text-scheme-secondary" for="sell-phone">
                    Phone <span class="text-scheme-secondary/50">(optional)</span>
                  </label>
                  <input
                    id="sell-phone"
                    type="tel"
                    x-model="personal.phone"
                    class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                    placeholder="+1 514 000 0000"
                  />
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs uppercase tracking-widest text-scheme-secondary" for="sell-email">
                  Email <span class="text-scheme-accent">*</span>
                </label>
                <input
                  id="sell-email"
                  type="email"
                  x-model="personal.email"
                  required
                  class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                  placeholder="you@example.com"
                />
              </div>

            </div>
          </div>

          {%- comment -%} ── Item blocks ── {%- endcomment -%}
          <div class="mb-6">
            <p class="mb-6 border-b border-current/10 pb-3 text-xs uppercase tracking-widest text-scheme-secondary">
              Items <span class="opacity-50">— up to 3</span>
            </p>

            <template x-for="(item, idx) in sellItems" :key="idx">
              <div class="mb-8 border border-current/10 p-5 sm:p-6">

                <div class="mb-5 flex items-center justify-between">
                  <p class="text-xs uppercase tracking-widest text-scheme-secondary" x-text="'Item ' + (idx + 1)"></p>
                  <button
                    type="button"
                    x-show="sellItems.length > 1"
                    @click="removeSellItem(idx)"
                    class="text-xs uppercase tracking-widest text-scheme-secondary underline underline-offset-2 hover:text-scheme-text"
                  >Remove</button>
                </div>

                <div class="flex flex-col gap-4">

                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                      Brand <span class="text-scheme-accent">*</span>
                    </label>
                    <input
                      type="text"
                      x-model="item.brand"
                      required
                      class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                      placeholder="e.g. Comme des Garçons"
                    />
                  </div>

                  <div class="grid gap-4 sm:grid-cols-2">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                        Category <span class="text-scheme-accent">*</span>
                      </label>
                      <div class="relative">
                        <select
                          x-model="item.category"
                          required
                          class="w-full appearance-none border border-gridline-color bg-transparent px-3 py-2.5 pr-8 text-sm text-scheme-text focus:border-scheme-text focus:outline-none"
                        >
                          <option value="" disabled selected>Select…</option>
                          <option value="Tops">上衣 Tops</option>
                          <option value="Bottoms">裤子 Bottoms</option>
                          <option value="Skirts">裙子 Skirts</option>
                          <option value="Outerwear">外套 Outerwear</option>
                          <option value="Bags">包袋 Bags</option>
                          <option value="Shoes">鞋履 Shoes</option>
                          <option value="Accessories">配饰 Accessories</option>
                        </select>
                        <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 opacity-60">
                          {%- render 'icon-chevron-down' -%}
                        </div>
                      </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                        Condition <span class="text-scheme-accent">*</span>
                      </label>
                      <div class="relative">
                        <select
                          x-model="item.condition"
                          required
                          class="w-full appearance-none border border-gridline-color bg-transparent px-3 py-2.5 pr-8 text-sm text-scheme-text focus:border-scheme-text focus:outline-none"
                        >
                          <option value="" disabled selected>Select…</option>
                          <option value="New with tags">全新 New with tags</option>
                          <option value="Like new">几乎全新 Like new</option>
                          <option value="Good">良好 Good</option>
                          <option value="Fair">一般 Fair</option>
                        </select>
                        <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 opacity-60">
                          {%- render 'icon-chevron-down' -%}
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="grid gap-4 sm:grid-cols-2">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                        Original Retail Price <span class="opacity-50">(optional)</span>
                      </label>
                      <input
                        type="text"
                        x-model="item.retail_price"
                        class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                        placeholder="e.g. $480"
                      />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                        Asking Price <span class="opacity-50">(optional)</span>
                      </label>
                      <input
                        type="text"
                        x-model="item.asking_price"
                        class="border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                        placeholder="e.g. $220"
                      />
                    </div>
                  </div>

                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                      Notes / Description
                    </label>
                    <textarea
                      x-model="item.notes"
                      rows="3"
                      class="resize-none border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
                      placeholder="Fabric, size, any flaws, styling notes…"
                    ></textarea>
                  </div>

                  <div class="flex flex-col gap-2">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                      Photos <span class="opacity-50">(up to 5 — jpg, png, heic)</span>
                    </label>

                    <div
                      x-show="item.photoPreviewUrls.length > 0"
                      class="flex flex-wrap gap-2"
                    >
                      <template x-for="(url, photoIdx) in item.photoPreviewUrls" :key="photoIdx">
                        <div class="relative h-20 w-20 border border-gridline-color">
                          <img :src="url" class="h-full w-full object-cover" />
                          <button
                            type="button"
                            @click="removePhoto(idx, photoIdx)"
                            class="absolute right-0.5 top-0.5 flex h-5 w-5 items-center justify-center bg-black/60 text-white"
                            aria-label="Remove photo"
                          >
                            <svg viewBox="0 0 10 10" fill="none" class="h-2.5 w-2.5">
                              <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            </svg>
                          </button>
                        </div>
                      </template>
                    </div>

                    <label
                      x-show="item.photoPreviewUrls.length < 5"
                      class="flex cursor-pointer items-center gap-2 border border-dashed border-gridline-color px-4 py-3 text-xs uppercase tracking-widest text-scheme-secondary transition-colors hover:border-scheme-text hover:text-scheme-text"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      </svg>
                      <span x-text="item.photoPreviewUrls.length > 0 ? 'Add more photos' : 'Add photos'"></span>
                      <input
                        type="file"
                        accept="image/jpeg,image/png,image/heic,image/heif"
                        multiple
                        class="sr-only"
                        @change="handlePhotoSelect(idx, $event)"
                      />
                    </label>
                  </div>

                </div>
              </div>
            </template>

            <button
              type="button"
              x-show="sellItems.length < 3"
              @click="addSellItem()"
              class="text-xs uppercase tracking-widest text-scheme-secondary underline underline-offset-4 hover:text-scheme-text"
            >
              + Add another item
            </button>
          </div>

          {%- comment -%} ── Additional notes ── {%- endcomment -%}
          <div class="mb-8 flex flex-col gap-1.5">
            <label class="text-xs uppercase tracking-widest text-scheme-secondary" for="sell-notes">
              Additional Notes <span class="opacity-50">(optional)</span>
            </label>
            <textarea
              id="sell-notes"
              x-model="additionalNotes"
              rows="3"
              class="resize-none border border-gridline-color bg-transparent px-3 py-2.5 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:border-scheme-text focus:outline-none"
              placeholder="Anything else you'd like us to know…"
            ></textarea>
          </div>

          {%- comment -%} Error message {%- endcomment -%}
          <p
            x-show="submitError"
            class="mb-4 text-sm text-scheme-accent"
            style="display: none;"
          >
            提交失败，请重试或发邮件给我们。<br>
            Something went wrong — please try again.
          </p>

          {%- comment -%} Submit {%- endcomment -%}
          <button
            type="button"
            @click="submitSell()"
            :disabled="submitting || !personal.name || !personal.email"
            :class="(submitting || !personal.name || !personal.email) ? 'opacity-40 cursor-not-allowed' : ''"
            class="theme-button flex w-full items-center justify-center gap-3 py-3.5 text-sm uppercase tracking-widest"
          >
            <span x-text="submitting ? '提交中… Submitting…' : 'Submit — 提交'"></span>
            <svg x-show="!submitting" width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path d="M9 1L13 5L9 9M1 5H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </button>

          <p class="mt-4 text-center text-xs leading-relaxed text-scheme-secondary">
            We'll review your submission and follow up within 3 business days.
          </p>

        </div>
      </div>
    </div>

  </div>

</div>

{%- comment -%} Calendly script — loads once, async {%- endcomment -%}
<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script>
const UPLOADCARE_PUBLIC_KEY = 'c17a3b92dc546a6a7692';
const MAKE_WEBHOOK_URL = 'https://hook.us2.make.com/tiov8xa5dpt67rueeohf6plhaxvepgjs';
const CALENDLY_URL = 'https://calendly.com/d/cxs6-ftd-gzq?hide_event_type_title=1&hide_gdpr_banner=1';

function defaultSellItem() {
  return {
    brand: '',
    category: '',
    condition: '',
    retail_price: '',
    asking_price: '',
    notes: '',
    photos: [],
    photoPreviewUrls: []
  };
}

function CommuneBookingPage() {
  return {
    showSellForm: false,
    calendlyInited: false,

    // Sell with Us
    personal: { name: '', email: '', phone: '' },
    sellItems: [defaultSellItem()],
    additionalNotes: '',
    submitting: false,
    submitted: false,
    submitError: false,

    init() {
      // Init Calendly immediately with current stack
      this.$nextTick(() => this.initCalendly());
    },

    buildStackText() {
      try {
        const stack = JSON.parse(localStorage.getItem('commune_stack') || '[]');
        if (stack.length === 0) return '';
        return 'Items to view:\n' + stack.map(item =>
          `- ${item.title}${item.vendor ? ' by ' + item.vendor : ''} — ${item.price}\n  ${window.location.origin}${item.url}`
        ).join('\n');
      } catch (e) {
        return '';
      }
    },

    initCalendly() {
      const el = document.getElementById('commune-calendly');
      if (!el) return;
      const stackText = this.buildStackText();

      const tryInit = () => {
        if (window.Calendly && window.Calendly.initInlineWidget) {
          window.Calendly.initInlineWidget({
            url: CALENDLY_URL,
            parentElement: el,
            prefill: {
              customAnswers: {
                a2: stackText
              }
            }
          });
          this.calendlyInited = true;
        } else {
          setTimeout(tryInit, 200);
        }
      };
      tryInit();
    },

    // Called when user removes a stack item — re-inits Calendly with updated list
    refreshCalendly() {
      const el = document.getElementById('commune-calendly');
      if (!el) return;
      el.innerHTML = '';
      this.calendlyInited = false;
      this.$nextTick(() => this.initCalendly());
    },

    // Sell with Us methods
    addSellItem() {
      if (this.sellItems.length < 3) this.sellItems.push(defaultSellItem());
    },

    removeSellItem(idx) {
      if (this.sellItems.length > 1) {
        this.sellItems[idx].photoPreviewUrls.forEach(url => URL.revokeObjectURL(url));
        this.sellItems.splice(idx, 1);
      }
    },

    handlePhotoSelect(idx, event) {
      const files = Array.from(event.target.files);
      const remaining = 5 - this.sellItems[idx].photoPreviewUrls.length;
      files.slice(0, remaining).forEach(file => {
        this.sellItems[idx].photos.push(file);
        this.sellItems[idx].photoPreviewUrls.push(URL.createObjectURL(file));
      });
      event.target.value = '';
    },

    removePhoto(itemIdx, photoIdx) {
      URL.revokeObjectURL(this.sellItems[itemIdx].photoPreviewUrls[photoIdx]);
      this.sellItems[itemIdx].photos.splice(photoIdx, 1);
      this.sellItems[itemIdx].photoPreviewUrls.splice(photoIdx, 1);
    },

    async uploadPhoto(file) {
      const fd = new FormData();
      fd.append('UPLOADCARE_PUB_KEY', UPLOADCARE_PUBLIC_KEY);
      fd.append('UPLOADCARE_STORE', 'auto');
      fd.append('file', file);
      const res = await fetch('https://upload.uploadcare.com/base/', { method: 'POST', body: fd });
      if (!res.ok) throw new Error('Upload failed');
      const data = await res.json();
      return 'https://ucarecdn.com/' + data.file + '/';
    },

    async submitSell() {
      this.submitting = true;
      this.submitError = false;

      try {
        const itemsPayload = await Promise.all(
          this.sellItems.map(async item => {
            const photoUrls = await Promise.all(item.photos.map(f => this.uploadPhoto(f)));
            return {
              brand: item.brand,
              category: item.category,
              condition: item.condition,
              retail_price: item.retail_price,
              asking_price: item.asking_price,
              notes: item.notes,
              photos: photoUrls
            };
          })
        );

        const payload = {
          name: this.personal.name,
          email: this.personal.email,
          phone: this.personal.phone,
          items: itemsPayload,
          additional_notes: this.additionalNotes,
          submitted_at: new Date().toISOString()
        };

        const res = await fetch(MAKE_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error('Webhook error');
        this.submitted = true;

      } catch (e) {
        console.error(e);
        this.submitError = true;
      } finally {
        this.submitting = false;
      }
    }
  };
}
</script>
