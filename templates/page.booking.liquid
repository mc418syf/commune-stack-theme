{%- comment -%}
  Commune237 — /pages/booking
  Tab A: Book a Fitting  — stack items + Calendly (initInlineWidget, a2 prefill)
  Tab B: Sell with Us    — Make.com webhook + Uploadcare photo uploads
  Design tokens: font-heading (uppercase, -0.05em tracking, lh 0.9), text-xs/sm/base,
  border-b-text (1px) for inputs, inline 12%-opacity hairlines for dividers,
  theme-button (pill, transparent bg, text border + arrow).
{%- endcomment -%}

<div
  class="color-scheme min-h-screen"
  data-color-scheme="default"
  x-data="CommuneBookingPage()"
  x-init="init()"
>

  {%- comment -%} ── Page header ── {%- endcomment -%}
  <div
    class="px-section-horizontal-spacing py-10 text-center lg:py-14"
    style="border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.12);"
  >
    <p class="mb-2 text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.2em;">Commune237 · Montréal</p>
    <h1 class="font-heading text-heading-standard">Book a Showroom Visit</h1>
  </div>

  {%- comment -%} ── Tab bar ── {%- endcomment -%}
  <div class="grid grid-cols-2" style="border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.12);">
    <button
      type="button"
      @click="tab = 'visit'; $nextTick(() => initCalendly())"
      class="px-section-horizontal-spacing py-4 text-left text-xs uppercase tracking-widest transition-colors duration-150"
      :class="tab === 'visit' ? 'bg-scheme-text text-scheme-background' : ''"
      style="border-right: 1px solid rgba(var(--color-scheme-text) / 0.12);"
      x-bind:style="tab !== 'visit' ? 'opacity: 0.5;' : ''"
    >Book a Fitting</button>
    <button
      type="button"
      @click="tab = 'sell'"
      class="px-section-horizontal-spacing py-4 text-left text-xs uppercase tracking-widest transition-colors duration-150"
      :class="tab === 'sell' ? 'bg-scheme-text text-scheme-background' : ''"
      x-bind:style="tab !== 'sell' ? 'opacity: 0.5;' : ''"
    >Sell with Us</button>
  </div>


  {%- comment -%} ══════════════════════════════════════
       TAB A — Book a Fitting
  ══════════════════════════════════════ {%- endcomment -%}
  <div x-show="tab === 'visit'" style="display:none;">
    <div class="lg:grid lg:grid-cols-[1fr_480px]">

      {%- comment -%} LEFT — Stack items {%- endcomment -%}
      <div
        class="px-section-horizontal-spacing py-12 lg:py-16"
        style="border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.12);"
        x-bind:style="window.innerWidth >= 1024 ? 'border-bottom: none; border-right: 1px solid rgba(var(--color-scheme-text) / 0.12);' : ''"
      >

        <p class="mb-1 text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.2em;">Your Stack</p>
        <h2 class="mb-8 font-heading text-heading-secondary">Pieces to Try On</h2>

        {%- comment -%} Empty state {%- endcomment -%}
        <div x-show="$store.stack.items.length === 0" style="display:none;">
          <p class="mb-6 text-sm leading-relaxed" style="opacity: 0.55;">
            Your stack is empty. Browse the archive and add pieces you'd like to try on.
          </p>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="theme-button inline-flex items-center gap-2 px-6 py-3 text-xs uppercase tracking-widest"
          >
            Browse Archive
          </a>
          <p class="mt-8 pt-6 text-xs leading-relaxed" style="border-top: 1px solid rgba(var(--color-scheme-text) / 0.12); opacity: 0.5;">
            You can still book a general browsing visit — just mention what you're looking for in Calendly's notes field.
          </p>
        </div>

        {%- comment -%} Items list {%- endcomment -%}
        <div x-show="$store.stack.items.length > 0" style="display:none;">
          <div style="border-top: 1px solid rgba(var(--color-scheme-text) / 0.12);">
            <template x-for="item in $store.stack.items" :key="item.variantId">
              <div
                class="flex gap-4 py-5"
                style="border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.08);"
              >
                <a :href="item.url" class="shrink-0">
                  <div class="commune-stack-thumb" style="background: rgba(var(--color-scheme-text) / 0.06);">
                    <img
                      x-show="item.image"
                      :src="item.image"
                      :alt="item.title"
                      class="h-full w-full object-cover"
                    />
                  </div>
                </a>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <p class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;" x-text="item.vendor"></p>
                  <a :href="item.url" class="text-sm leading-snug" x-text="item.title"></a>
                  <p class="text-xs" style="opacity: 0.55;" x-text="item.price"></p>
                </div>
                <button
                  type="button"
                  @click="$store.stack.remove(item.variantId)"
                  aria-label="Remove from stack"
                  style="background:none;border:none;cursor:pointer;font-size:18px;line-height:1;padding:0;opacity:0.35;flex-shrink:0;align-self:flex-start;"
                  onmouseover="this.style.opacity='1'"
                  onmouseout="this.style.opacity='0.35'"
                >×</button>
              </div>
            </template>
          </div>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="mt-5 inline-block text-xs uppercase tracking-widest"
            style="opacity: 0.5; border-bottom: 1px solid currentColor; padding-bottom: 2px;"
            onmouseover="this.style.opacity='1'"
            onmouseout="this.style.opacity='0.5'"
          >+ Add more pieces</a>
        </div>

      </div>

      {%- comment -%} RIGHT — Calendly {%- endcomment -%}
      <div class="px-section-horizontal-spacing py-12 lg:py-16">

        <p class="mb-1 text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.2em;">Book Your Visit</p>
        <h2 class="mb-6 font-heading text-heading-secondary">Private Showroom<br>Appointment</h2>

        <p class="mb-8 text-sm leading-relaxed" style="opacity: 0.55;">
          Select a date and time — we'll confirm within 24 hours.
        </p>

        <div class="mb-6">
          <p class="mb-2 text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.2em;">Location</p>
          <p class="text-sm leading-relaxed">
            237 Keefer Street, Montréal<br>
            <span style="opacity: 0.55;">Tue–Sat, 11am–6pm, by appointment</span>
          </p>
        </div>

        <p class="mb-6 text-xs" style="opacity: 0.4;">No payment required. No commitment to purchase.</p>

        {%- comment -%} Single Calendly embed — initialised by initCalendly() {%- endcomment -%}
        <div id="commune-calendly" style="min-height:620px; margin-left: calc(-1 * var(--section-horizontal-spacing)); margin-right: calc(-1 * var(--section-horizontal-spacing));"></div>

      </div>

    </div>
  </div>


  {%- comment -%} ══════════════════════════════════════
       TAB B — Sell with Us
  ══════════════════════════════════════ {%- endcomment -%}
  <div x-show="tab === 'sell'" style="display:none;">
    <div class="mx-auto max-w-2xl px-section-horizontal-spacing py-12 lg:py-16">

      {%- comment -%} Success state {%- endcomment -%}
      <div x-show="submitted" class="py-16 text-center" style="display:none;">
        <h2 class="mb-4 font-heading text-heading-secondary">Thank you!</h2>
        <p class="text-sm leading-relaxed" style="opacity: 0.6;">
          We'll be in touch within 3 business days.
        </p>
      </div>

      {%- comment -%} Form {%- endcomment -%}
      <div x-show="!submitted" style="display:none;">

        {%- comment -%} ── Personal info ── {%- endcomment -%}
        <div class="mb-10">
          <p
            class="mb-6 pb-3 text-xs uppercase tracking-widest"
            style="opacity: 0.4; letter-spacing: 0.2em; border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.12);"
          >Contact</p>

          <div class="flex flex-col gap-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                  Full Name <span style="opacity: 0.7;">*</span>
                </label>
                <input
                  type="text"
                  x-model="personal.name"
                  placeholder="Jane Smith"
                  class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                  style="width: 100%;"
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">Phone</label>
                <input
                  type="tel"
                  x-model="personal.phone"
                  placeholder="+1 514…"
                  class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                  style="width: 100%;"
                />
              </div>
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                Email <span style="opacity: 0.7;">*</span>
              </label>
              <input
                type="email"
                x-model="personal.email"
                placeholder="you@example.com"
                class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                style="width: 100%;"
              />
            </div>
          </div>
        </div>

        {%- comment -%} ── Item blocks ── {%- endcomment -%}
        <div class="mb-8">
          <p
            class="mb-6 pb-3 text-xs uppercase tracking-widest"
            style="opacity: 0.4; letter-spacing: 0.2em; border-bottom: 1px solid rgba(var(--color-scheme-text) / 0.12);"
          >Items <span style="opacity: 0.6;">— up to 3</span></p>

          <template x-for="(item, idx) in sellItems" :key="idx">
            <div class="mb-8 pt-5" style="border-top: 1px solid rgba(var(--color-scheme-text) / 0.12);">

              <div class="mb-5 flex items-center justify-between">
                <p class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;" x-text="'Item ' + (idx + 1)"></p>
                <button
                  type="button"
                  x-show="sellItems.length > 1"
                  @click="removeSellItem(idx)"
                  class="text-xs uppercase tracking-widest"
                  style="background:none;border:none;cursor:pointer;padding:0;opacity:0.45;border-bottom:1px solid currentColor;padding-bottom:1px;"
                  onmouseover="this.style.opacity='1'"
                  onmouseout="this.style.opacity='0.45'"
                >Remove</button>
              </div>

              <div class="flex flex-col gap-5">

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                    Brand <span style="opacity: 0.7;">*</span>
                  </label>
                  <input
                    type="text"
                    x-model="item.brand"
                    placeholder="e.g. Comme des Garçons"
                    class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                    style="width: 100%;"
                  />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                      Category <span style="opacity: 0.7;">*</span>
                    </label>
                    <div class="relative">
                      <select
                        x-model="item.category"
                        class="w-full border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                        style="appearance: none; padding-right: 1.5rem;"
                      >
                        <option value="" disabled selected>Select…</option>
                        <option value="Tops">Tops</option>
                        <option value="Bottoms">Bottoms</option>
                        <option value="Skirts">Skirts</option>
                        <option value="Outerwear">Outerwear</option>
                        <option value="Bags">Bags</option>
                        <option value="Shoes">Shoes</option>
                        <option value="Accessories">Accessories</option>
                      </select>
                      <div class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2" style="opacity: 0.4;">
                        {%- render 'icon-chevron-down' -%}
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                      Condition <span style="opacity: 0.7;">*</span>
                    </label>
                    <div class="relative">
                      <select
                        x-model="item.condition"
                        class="w-full border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                        style="appearance: none; padding-right: 1.5rem;"
                      >
                        <option value="" disabled selected>Select…</option>
                        <option value="New with tags">New with tags</option>
                        <option value="Like new">Like new</option>
                        <option value="Good">Good</option>
                        <option value="Fair">Fair</option>
                      </select>
                      <div class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2" style="opacity: 0.4;">
                        {%- render 'icon-chevron-down' -%}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">Original Price</label>
                    <input
                      type="text"
                      x-model="item.retail_price"
                      placeholder="e.g. $480"
                      class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                      style="width: 100%;"
                    />
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">Asking Price</label>
                    <input
                      type="text"
                      x-model="item.asking_price"
                      placeholder="e.g. $220"
                      class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                      style="width: 100%;"
                    />
                  </div>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">Notes</label>
                  <textarea
                    x-model="item.notes"
                    rows="3"
                    placeholder="Fabric, size, any flaws…"
                    class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
                    style="width: 100%; resize: none;"
                  ></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">
                    Photos <span style="opacity: 0.6;">(up to 5)</span>
                  </label>
                  <div x-show="item.photoPreviewUrls.length > 0" class="flex flex-wrap gap-2">
                    <template x-for="(url, photoIdx) in item.photoPreviewUrls" :key="photoIdx">
                      <div class="relative h-20 w-20" style="border: 1px solid rgba(var(--color-scheme-text) / 0.15);">
                        <img :src="url" class="h-full w-full object-cover" />
                        <button
                          type="button"
                          @click="removePhoto(idx, photoIdx)"
                          class="absolute right-0.5 top-0.5 flex h-5 w-5 items-center justify-center"
                          style="background: rgba(0,0,0,0.6); border: none; color: #fff; cursor: pointer;"
                        >
                          <svg viewBox="0 0 10 10" fill="none" class="h-2.5 w-2.5">
                            <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>
                    </template>
                  </div>
                  <label
                    x-show="item.photoPreviewUrls.length < 5"
                    class="flex cursor-pointer items-center gap-2 py-3 text-xs uppercase tracking-widest"
                    style="border: 1px solid rgba(var(--color-scheme-text) / 0.2); padding-left: 12px; opacity: 0.6;"
                    onmouseover="this.style.opacity='1'; this.style.borderColor='rgba(var(--color-scheme-text) / 0.7)'"
                    onmouseout="this.style.opacity='0.6'; this.style.borderColor='rgba(var(--color-scheme-text) / 0.2)'"
                  >
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    <span x-text="item.photoPreviewUrls.length > 0 ? 'Add more' : 'Add photos'"></span>
                    <input
                      type="file"
                      accept="image/jpeg,image/png,image/heic,image/heif"
                      multiple
                      class="sr-only"
                      @change="handlePhotoSelect(idx, $event)"
                    />
                  </label>
                </div>

              </div>
            </div>
          </template>

          <button
            type="button"
            x-show="sellItems.length < 3"
            @click="addSellItem()"
            class="mt-1 text-xs uppercase tracking-widest"
            style="background:none;border:none;cursor:pointer;padding:0;opacity:0.5;border-bottom:1px solid currentColor;padding-bottom:1px;"
            onmouseover="this.style.opacity='1'"
            onmouseout="this.style.opacity='0.5'"
          >+ Add another item</button>
        </div>

        {%- comment -%} ── Additional notes ── {%- endcomment -%}
        <div class="mb-8 flex flex-col gap-1.5">
          <label class="text-xs uppercase tracking-widest" style="opacity: 0.4; letter-spacing: 0.16em;">Additional Notes</label>
          <textarea
            x-model="additionalNotes"
            rows="3"
            placeholder="Anything else you'd like us to know…"
            class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm focus:outline-none"
            style="width: 100%; resize: none;"
          ></textarea>
        </div>

        {%- comment -%} ── Error ── {%- endcomment -%}
        <p x-show="submitError" class="mb-4 text-sm" style="display:none; opacity: 0.7;">
          Something went wrong — please try again.
        </p>

        {%- comment -%} ── Submit ── {%- endcomment -%}
        <button
          type="button"
          @click="submitSell()"
          :disabled="submitting || !personal.name || !personal.email"
          class="theme-button flex w-full items-center justify-center gap-2 py-4 text-xs uppercase tracking-widest"
          x-bind:style="(submitting || !personal.name || !personal.email) ? 'opacity: 0.4; cursor: not-allowed;' : ''"
        >
          <span x-text="submitting ? 'Submitting…' : 'Submit'"></span>
        </button>
        <p class="mt-4 text-center text-xs leading-relaxed" style="opacity: 0.4;">
          We'll review your submission and follow up within 3 business days.
        </p>

      </div>
    </div>
  </div>

</div>

{%- comment -%} Calendly script — loaded once {%- endcomment -%}
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script>
const CALENDLY_URL     = 'https://calendly.com/commune237/showroomappointment';
const UPLOADCARE_KEY   = 'c17a3b92dc546a6a7692';
const MAKE_WEBHOOK_URL = 'MAKE_WEBHOOK_URL_HERE';

function defaultSellItem() {
  return {
    brand: '', category: '', condition: '',
    retail_price: '', asking_price: '', notes: '',
    photos: [], photoPreviewUrls: []
  };
}

function CommuneBookingPage() {
  return {
    tab: 'visit',
    calendlyInited: false,

    personal: { name: '', email: '', phone: '' },
    sellItems: [defaultSellItem()],
    additionalNotes: '',
    submitting: false,
    submitted: false,
    submitError: false,

    init() {
      this.$nextTick(() => this.initCalendly());
    },

    buildStackText() {
      try {
        const items = JSON.parse(localStorage.getItem('commune_stack') || '[]');
        if (!items.length) return '';
        return 'Items to try:\n' + items.map(i =>
          `- ${i.title}${i.vendor ? ' by ' + i.vendor : ''} — ${i.price}`
        ).join('\n');
      } catch { return ''; }
    },

    initCalendly() {
      if (this.calendlyInited) return;
      const el = document.getElementById('commune-calendly');
      if (!el) return;
      const stackText = this.buildStackText();
      const tryInit = () => {
        if (window.Calendly?.initInlineWidget) {
          window.Calendly.initInlineWidget({
            url: CALENDLY_URL,
            parentElement: el,
            prefill: { customAnswers: { a2: stackText } }
          });
          this.calendlyInited = true;
        } else {
          setTimeout(tryInit, 200);
        }
      };
      tryInit();
    },

    addSellItem() {
      if (this.sellItems.length < 3) this.sellItems.push(defaultSellItem());
    },

    removeSellItem(idx) {
      if (this.sellItems.length > 1) {
        this.sellItems[idx].photoPreviewUrls.forEach(u => URL.revokeObjectURL(u));
        this.sellItems.splice(idx, 1);
      }
    },

    handlePhotoSelect(idx, event) {
      const files = Array.from(event.target.files);
      const remaining = 5 - this.sellItems[idx].photoPreviewUrls.length;
      files.slice(0, remaining).forEach(file => {
        this.sellItems[idx].photos.push(file);
        this.sellItems[idx].photoPreviewUrls.push(URL.createObjectURL(file));
      });
      event.target.value = '';
    },

    removePhoto(itemIdx, photoIdx) {
      URL.revokeObjectURL(this.sellItems[itemIdx].photoPreviewUrls[photoIdx]);
      this.sellItems[itemIdx].photos.splice(photoIdx, 1);
      this.sellItems[itemIdx].photoPreviewUrls.splice(photoIdx, 1);
    },

    async uploadPhoto(file) {
      const fd = new FormData();
      fd.append('UPLOADCARE_PUB_KEY', UPLOADCARE_KEY);
      fd.append('UPLOADCARE_STORE', 'auto');
      fd.append('file', file);
      const res = await fetch('https://upload.uploadcare.com/base/', { method: 'POST', body: fd });
      if (!res.ok) throw new Error('upload failed');
      const { file: uuid } = await res.json();
      return `https://ucarecdn.com/${uuid}/`;
    },

    async submitSell() {
      this.submitting = true;
      this.submitError = false;
      try {
        const items = await Promise.all(this.sellItems.map(async item => ({
          brand:        item.brand,
          category:     item.category,
          condition:    item.condition,
          retail_price: item.retail_price,
          asking_price: item.asking_price,
          notes:        item.notes,
          photos:       await Promise.all(item.photos.map(f => this.uploadPhoto(f)))
        })));
        const res = await fetch(MAKE_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name:             this.personal.name,
            email:            this.personal.email,
            phone:            this.personal.phone,
            items,
            additional_notes: this.additionalNotes,
            submitted_at:     new Date().toISOString()
          })
        });
        if (!res.ok) throw new Error('webhook error');
        this.submitted = true;
      } catch (e) {
        console.error(e);
        this.submitError = true;
      } finally {
        this.submitting = false;
      }
    }
  };
}
</script>
