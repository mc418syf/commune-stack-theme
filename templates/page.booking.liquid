{%- comment -%}
  Commune237 — /pages/booking
  Tab A: Book a Fitting  — stack items + Calendly (initInlineWidget, a2 prefill)
  Tab B: Sell with Us    — Make.com webhook + Uploadcare photo uploads
  Styled with the same Broadcast theme tokens as cart-items / cart-footer.
{%- endcomment -%}

<div
  class="color-scheme min-h-screen"
  data-color-scheme="default"
  x-data="CommuneBookingPage()"
  x-init="init()"
>

  {%- comment -%} ── Page header ── {%- endcomment -%}
  <div class="border-b-gridline border-gridline-color px-section-horizontal-spacing py-12 text-center lg:py-16">
    <p class="mb-3 text-xs uppercase tracking-widest text-scheme-secondary">Commune237 · Montréal</p>
    <h1 class="font-heading text-heading-standard">Book a Showroom Visit</h1>
  </div>

  {%- comment -%} ── Tab bar ── {%- endcomment -%}
  <div class="grid grid-cols-2 border-b-gridline border-gridline-color">
    <button
      type="button"
      @click="tab = 'visit'; $nextTick(() => initCalendly())"
      class="border-r-gridline border-gridline-color px-section-horizontal-spacing py-5 text-left text-xs uppercase tracking-widest transition-colors"
      :class="tab === 'visit'
        ? 'bg-scheme-text text-scheme-background'
        : 'text-scheme-secondary hover:text-scheme-text'"
    >Book a Fitting</button>
    <button
      type="button"
      @click="tab = 'sell'"
      class="px-section-horizontal-spacing py-5 text-left text-xs uppercase tracking-widest transition-colors"
      :class="tab === 'sell'
        ? 'bg-scheme-text text-scheme-background'
        : 'text-scheme-secondary hover:text-scheme-text'"
    >Sell with Us</button>
  </div>


  {%- comment -%} ══════════════════════════════════════
       TAB A — Book a Fitting
  ══════════════════════════════════════ {%- endcomment -%}
  <div x-show="tab === 'visit'" style="display:none;">
    <div class="lg:grid lg:grid-cols-[1fr_480px]">

      {%- comment -%} LEFT — Stack items {%- endcomment -%}
      <div class="border-b-gridline border-gridline-color px-section-horizontal-spacing py-12 lg:border-b-0 lg:border-r-gridline lg:py-16">

        <p class="mb-2 text-xs uppercase tracking-widest text-scheme-secondary">Your Stack</p>
        <h2 class="mb-8 font-heading" style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 300; line-height: 1.15;">
          Pieces to Try On
        </h2>

        {%- comment -%} Empty state {%- endcomment -%}
        <div x-show="$store.stack.items.length === 0" style="display:none;">
          <p class="mb-5 text-sm leading-relaxed text-scheme-secondary">
            Your stack is empty. Browse the archive and add pieces you'd like to try on.
          </p>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="theme-button inline-flex items-center gap-2 px-6 py-3 text-xs uppercase tracking-widest"
          >
            Browse Archive
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path d="M9 1L13 5L9 9M1 5H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </a>
          <div class="mt-8 border-t-gridline border-gridline-color pt-6">
            <p class="text-xs leading-relaxed text-scheme-secondary">
              You can still book a general browsing visit — just mention what you're looking for in Calendly's notes field.
            </p>
          </div>
        </div>

        {%- comment -%} Items list {%- endcomment -%}
        <div x-show="$store.stack.items.length > 0" style="display:none;">
          <div class="divide-y divide-gridline-color border-t-gridline border-gridline-color">
            <template x-for="item in $store.stack.items" :key="item.variantId">
              <div class="flex gap-4 py-5">
                <a :href="item.url" class="shrink-0">
                  <div class="commune-stack-thumb bg-scheme-secondary/10">
                    <img
                      x-show="item.image"
                      :src="item.image"
                      :alt="item.title"
                      class="h-full w-full object-cover"
                    />
                  </div>
                </a>
                <div class="flex min-w-0 flex-1 flex-col">
                  <p class="mb-0.5 text-xs uppercase tracking-widest text-scheme-secondary" x-text="item.vendor"></p>
                  <a :href="item.url" class="mb-1 text-sm leading-snug" x-text="item.title"></a>
                  <p class="mt-1 text-sm text-scheme-secondary" x-text="item.price"></p>
                </div>
                <button
                  type="button"
                  @click="$store.stack.remove(item.variantId)"
                  aria-label="Remove from stack"
                  style="background:none;border:none;cursor:pointer;font-size:20px;line-height:1;padding:0;color:#888;flex-shrink:0;align-self:flex-start;"
                  onmouseover="this.style.color='currentColor'"
                  onmouseout="this.style.color='#888'"
                >×</button>
              </div>
            </template>
          </div>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="mt-6 inline-flex items-center gap-1.5 border-b border-gridline-color pb-0.5 text-xs uppercase tracking-widest text-scheme-secondary hover:border-scheme-text hover:text-scheme-text"
          >+ Add more pieces</a>
        </div>
      </div>

      {%- comment -%} RIGHT — Calendly {%- endcomment -%}
      <div class="px-section-horizontal-spacing py-12 lg:py-16">
        <p class="mb-2 text-xs uppercase tracking-widest text-scheme-secondary">Book Your Visit</p>
        <h2 class="mb-3 font-heading" style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 300; line-height: 1.15;">
          Private Showroom<br>Appointment
        </h2>
        <p class="mb-6 text-sm leading-relaxed text-scheme-secondary">
          Select a date and time — we'll confirm within 24 hours.
        </p>

        <div class="mb-6 border-l-2 border-scheme-text pl-4">
          <p class="mb-1 text-xs uppercase tracking-widest text-scheme-secondary">Location</p>
          <p class="text-sm leading-relaxed">
            <strong class="font-medium">Commune237 Montréal</strong><br>
            237 Keefer Street<br>
            <span class="text-scheme-secondary">Tue–Sat, 11am–6pm, by appointment</span>
          </p>
        </div>

        <p class="mb-5 text-xs text-scheme-secondary">No payment required. No commitment to purchase.</p>

        {%- comment -%} Single Calendly embed — initialised by initCalendly() on tab click {%- endcomment -%}
        <div id="commune-calendly" style="min-height:620px;"></div>
      </div>

    </div>
  </div>


  {%- comment -%} ══════════════════════════════════════
       TAB B — Sell with Us
  ══════════════════════════════════════ {%- endcomment -%}
  <div x-show="tab === 'sell'" style="display:none;">
    <div class="mx-auto max-w-2xl px-section-horizontal-spacing py-12 lg:py-16">

      {%- comment -%} Success state {%- endcomment -%}
      <div x-show="submitted" class="py-16 text-center" style="display:none;">
        <p class="mb-3 font-heading text-2xl font-light">感谢你的提交！</p>
        <p class="text-sm leading-relaxed text-scheme-secondary">
          We'll be in touch within 3 business days.<br>
          我们会在3个工作日内回复。
        </p>
      </div>

      {%- comment -%} Form {%- endcomment -%}
      <div x-show="!submitted" style="display:none;">

        {%- comment -%} ── Personal info ── {%- endcomment -%}
        <div class="mb-8">
          <p class="mb-5 border-b-gridline border-gridline-color pb-3 text-xs uppercase tracking-widest text-scheme-secondary">Contact</p>
          <div class="flex flex-col gap-5">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                  Full Name <span class="text-scheme-accent">*</span>
                </label>
                <input
                  type="text"
                  x-model="personal.name"
                  placeholder="Jane Smith"
                  class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                />
              </div>
              <div class="flex flex-col gap-2">
                <label class="text-xs uppercase tracking-widest text-scheme-secondary">Phone</label>
                <input
                  type="tel"
                  x-model="personal.phone"
                  placeholder="+1 514…"
                  class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                />
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                Email <span class="text-scheme-accent">*</span>
              </label>
              <input
                type="email"
                x-model="personal.email"
                placeholder="you@example.com"
                class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
              />
            </div>
          </div>
        </div>

        {%- comment -%} ── Item blocks ── {%- endcomment -%}
        <div class="mb-6">
          <p class="mb-5 border-b-gridline border-gridline-color pb-3 text-xs uppercase tracking-widest text-scheme-secondary">
            Items <span class="opacity-50">— up to 3</span>
          </p>

          <template x-for="(item, idx) in sellItems" :key="idx">
            <div class="mb-6 border-gridline-color border-t-gridline pt-5">

              <div class="mb-4 flex items-center justify-between">
                <p class="text-xs uppercase tracking-widest text-scheme-secondary" x-text="'Item ' + (idx + 1)"></p>
                <button
                  type="button"
                  x-show="sellItems.length > 1"
                  @click="removeSellItem(idx)"
                  class="text-xs uppercase tracking-widest text-scheme-secondary underline underline-offset-2 hover:text-scheme-text"
                >Remove</button>
              </div>

              <div class="flex flex-col gap-4">

                <div class="flex flex-col gap-2">
                  <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                    Brand <span class="text-scheme-accent">*</span>
                  </label>
                  <input
                    type="text"
                    x-model="item.brand"
                    placeholder="e.g. Comme des Garçons"
                    class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                  />
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                      Category <span class="text-scheme-accent">*</span>
                    </label>
                    <div class="relative">
                      <select
                        x-model="item.category"
                        class="w-full appearance-none border-b-text border-scheme-text bg-scheme-background py-2 pr-6 text-sm text-scheme-text focus:outline-none"
                      >
                        <option value="" disabled selected>Select…</option>
                        <option value="Tops">上衣 Tops</option>
                        <option value="Bottoms">裤子 Bottoms</option>
                        <option value="Skirts">裙子 Skirts</option>
                        <option value="Outerwear">外套 Outerwear</option>
                        <option value="Bags">包袋 Bags</option>
                        <option value="Shoes">鞋履 Shoes</option>
                        <option value="Accessories">配饰 Accessories</option>
                      </select>
                      <div class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2 opacity-50">
                        {%- render 'icon-chevron-down' -%}
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-col gap-2">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                      Condition <span class="text-scheme-accent">*</span>
                    </label>
                    <div class="relative">
                      <select
                        x-model="item.condition"
                        class="w-full appearance-none border-b-text border-scheme-text bg-scheme-background py-2 pr-6 text-sm text-scheme-text focus:outline-none"
                      >
                        <option value="" disabled selected>Select…</option>
                        <option value="New with tags">全新 New with tags</option>
                        <option value="Like new">几乎全新 Like new</option>
                        <option value="Good">良好 Good</option>
                        <option value="Fair">一般 Fair</option>
                      </select>
                      <div class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2 opacity-50">
                        {%- render 'icon-chevron-down' -%}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div class="flex flex-col gap-2">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">Original Price</label>
                    <input
                      type="text"
                      x-model="item.retail_price"
                      placeholder="e.g. $480"
                      class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                    />
                  </div>
                  <div class="flex flex-col gap-2">
                    <label class="text-xs uppercase tracking-widest text-scheme-secondary">Asking Price</label>
                    <input
                      type="text"
                      x-model="item.asking_price"
                      placeholder="e.g. $220"
                      class="border-b-text border-scheme-text bg-scheme-background py-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                    />
                  </div>
                </div>

                <div class="flex flex-col gap-2">
                  <label class="text-xs uppercase tracking-widest text-scheme-secondary">Notes / Description</label>
                  <textarea
                    x-model="item.notes"
                    rows="3"
                    placeholder="Fabric, size, any flaws, styling notes…"
                    class="resize-none border-gridline-color border-t-gridline bg-scheme-background p-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
                  ></textarea>
                </div>

                <div class="flex flex-col gap-2">
                  <label class="text-xs uppercase tracking-widest text-scheme-secondary">
                    Photos <span class="opacity-50">(up to 5 — jpg, png, heic)</span>
                  </label>
                  <div x-show="item.photoPreviewUrls.length > 0" class="flex flex-wrap gap-2">
                    <template x-for="(url, photoIdx) in item.photoPreviewUrls" :key="photoIdx">
                      <div class="relative h-20 w-20 border-gridline-color border-t-gridline">
                        <img :src="url" class="h-full w-full object-cover" />
                        <button
                          type="button"
                          @click="removePhoto(idx, photoIdx)"
                          class="absolute right-0.5 top-0.5 flex h-5 w-5 items-center justify-center bg-black/60 text-white"
                        >
                          <svg viewBox="0 0 10 10" fill="none" class="h-2.5 w-2.5">
                            <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>
                    </template>
                  </div>
                  <label
                    x-show="item.photoPreviewUrls.length < 5"
                    class="flex cursor-pointer items-center gap-2 border-gridline-color border-t-gridline px-3 py-3 text-xs uppercase tracking-widest text-scheme-secondary hover:border-scheme-text hover:text-scheme-text"
                  >
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    <span x-text="item.photoPreviewUrls.length > 0 ? 'Add more photos' : 'Add photos'"></span>
                    <input
                      type="file"
                      accept="image/jpeg,image/png,image/heic,image/heif"
                      multiple
                      class="sr-only"
                      @change="handlePhotoSelect(idx, $event)"
                    />
                  </label>
                </div>

              </div>
            </div>
          </template>

          <button
            type="button"
            x-show="sellItems.length < 3"
            @click="addSellItem()"
            class="mt-2 text-xs uppercase tracking-widest text-scheme-secondary underline underline-offset-4 hover:text-scheme-text"
          >+ Add another item</button>
        </div>

        {%- comment -%} ── Additional notes ── {%- endcomment -%}
        <div class="mb-8 flex flex-col gap-2">
          <label class="text-xs uppercase tracking-widest text-scheme-secondary">Additional Notes</label>
          <textarea
            x-model="additionalNotes"
            rows="3"
            placeholder="Anything else you'd like us to know…"
            class="resize-none border-gridline-color border-t-gridline bg-scheme-background p-2 text-sm text-scheme-text placeholder-scheme-secondary/50 focus:outline-none"
          ></textarea>
        </div>

        {%- comment -%} ── Error ── {%- endcomment -%}
        <p x-show="submitError" class="mb-4 text-sm text-scheme-accent" style="display:none;">
          提交失败，请重试。 Something went wrong — please try again.
        </p>

        {%- comment -%} ── Submit ── {%- endcomment -%}
        <button
          type="button"
          @click="submitSell()"
          :disabled="submitting || !personal.name || !personal.email"
          :class="(submitting || !personal.name || !personal.email) ? 'opacity-40 cursor-not-allowed' : ''"
          class="theme-button flex w-full items-center justify-center gap-2 py-3.5 text-sm uppercase tracking-widest"
        >
          <span x-text="submitting ? '提交中… Submitting…' : 'Submit — 提交'"></span>
        </button>
        <p class="mt-4 text-center text-xs leading-relaxed text-scheme-secondary">
          We'll review your submission and follow up within 3 business days.
        </p>

      </div>
    </div>
  </div>

</div>

{%- comment -%} Calendly script — loaded once {%- endcomment -%}
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script>
const CALENDLY_URL     = 'https://calendly.com/commune237/showroomappointment';
const UPLOADCARE_KEY   = 'c17a3b92dc546a6a7692';
const MAKE_WEBHOOK_URL = 'MAKE_WEBHOOK_URL_HERE';

function defaultSellItem() {
  return {
    brand: '', category: '', condition: '',
    retail_price: '', asking_price: '', notes: '',
    photos: [], photoPreviewUrls: []
  };
}

function CommuneBookingPage() {
  return {
    tab: 'visit',
    calendlyInited: false,

    personal: { name: '', email: '', phone: '' },
    sellItems: [defaultSellItem()],
    additionalNotes: '',
    submitting: false,
    submitted: false,
    submitError: false,

    init() {
      // Calendly loads after the async script — retry until ready
      this.$nextTick(() => this.initCalendly());
    },

    buildStackText() {
      try {
        const items = JSON.parse(localStorage.getItem('commune_stack') || '[]');
        if (!items.length) return '';
        return 'Items to try:\n' + items.map(i =>
          `- ${i.title}${i.vendor ? ' by ' + i.vendor : ''} — ${i.price}`
        ).join('\n');
      } catch { return ''; }
    },

    initCalendly() {
      if (this.calendlyInited) return;
      const el = document.getElementById('commune-calendly');
      if (!el) return;
      const stackText = this.buildStackText();
      const tryInit = () => {
        if (window.Calendly?.initInlineWidget) {
          window.Calendly.initInlineWidget({
            url: CALENDLY_URL,
            parentElement: el,
            prefill: { customAnswers: { a2: stackText } }
          });
          this.calendlyInited = true;
        } else {
          setTimeout(tryInit, 200);
        }
      };
      tryInit();
    },

    addSellItem() {
      if (this.sellItems.length < 3) this.sellItems.push(defaultSellItem());
    },

    removeSellItem(idx) {
      if (this.sellItems.length > 1) {
        this.sellItems[idx].photoPreviewUrls.forEach(u => URL.revokeObjectURL(u));
        this.sellItems.splice(idx, 1);
      }
    },

    handlePhotoSelect(idx, event) {
      const files = Array.from(event.target.files);
      const remaining = 5 - this.sellItems[idx].photoPreviewUrls.length;
      files.slice(0, remaining).forEach(file => {
        this.sellItems[idx].photos.push(file);
        this.sellItems[idx].photoPreviewUrls.push(URL.createObjectURL(file));
      });
      event.target.value = '';
    },

    removePhoto(itemIdx, photoIdx) {
      URL.revokeObjectURL(this.sellItems[itemIdx].photoPreviewUrls[photoIdx]);
      this.sellItems[itemIdx].photos.splice(photoIdx, 1);
      this.sellItems[itemIdx].photoPreviewUrls.splice(photoIdx, 1);
    },

    async uploadPhoto(file) {
      const fd = new FormData();
      fd.append('UPLOADCARE_PUB_KEY', UPLOADCARE_KEY);
      fd.append('UPLOADCARE_STORE', 'auto');
      fd.append('file', file);
      const res = await fetch('https://upload.uploadcare.com/base/', { method: 'POST', body: fd });
      if (!res.ok) throw new Error('upload failed');
      const { file: uuid } = await res.json();
      return `https://ucarecdn.com/${uuid}/`;
    },

    async submitSell() {
      this.submitting = true;
      this.submitError = false;
      try {
        const items = await Promise.all(this.sellItems.map(async item => ({
          brand:        item.brand,
          category:     item.category,
          condition:    item.condition,
          retail_price: item.retail_price,
          asking_price: item.asking_price,
          notes:        item.notes,
          photos:       await Promise.all(item.photos.map(f => this.uploadPhoto(f)))
        })));
        const res = await fetch(MAKE_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name:             this.personal.name,
            email:            this.personal.email,
            phone:            this.personal.phone,
            items,
            additional_notes: this.additionalNotes,
            submitted_at:     new Date().toISOString()
          })
        });
        if (!res.ok) throw new Error('webhook error');
        this.submitted = true;
      } catch (e) {
        console.error(e);
        this.submitError = true;
      } finally {
        this.submitting = false;
      }
    }
  };
}
</script>
